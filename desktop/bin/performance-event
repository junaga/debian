#!/usr/bin/python3
"""Supplement Atop history with GPU samples, markers and unattended reports."""
import ctypes as C
import datetime as dt
import gzip
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys


LOG_DIR = Path("/var/log/atop")
BURST_STATE = LOG_DIR / "burst-state.json"
BURST_LIMIT = 120
BURST_SECONDS = 30
RAW_LIMIT_BYTES = 160_000_000
CPU_FIELDS = ("user", "nice", "system", "idle", "iowait", "irq", "softirq", "steal")


def stamp():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def boot_id():
    try:
        value = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        return value or None
    except (OSError, UnicodeError):
        return None


def proc_stat():
    """Read the small, counter-only portion of /proc/stat.

    The kernel's aggregate row and at most the first eight CPU rows are enough
    to calculate utilization while keeping the five-second timeline compact.
    """
    rows = {}
    try:
        for line in Path("/proc/stat").read_text().splitlines():
            fields = line.split()
            if not fields or (fields[0] != "cpu" and not re.fullmatch(r"cpu[0-9]+", fields[0])):
                continue
            if fields[0] != "cpu" and int(fields[0][3:]) >= 8:
                continue
            values = [int(value) for value in fields[1:1 + len(CPU_FIELDS)]]
            if len(values) == len(CPU_FIELDS):
                rows[fields[0]] = values
    except (OSError, UnicodeError, ValueError):
        return {}
    total = rows.pop("cpu", None)
    if total is None:
        return {}
    return {"total": total,
            "cores": {key[3:]: rows[key] for key in sorted(rows, key=lambda key: int(key[3:]))}}


def proc_values(path, wanted, scale=1):
    values = {}
    try:
        for line in Path(path).read_text().splitlines():
            fields = line.split()
            if len(fields) < 2 or fields[0] not in wanted:
                continue
            try:
                values[wanted[fields[0]]] = int(fields[1]) * scale
            except (ValueError, OverflowError):
                continue
    except (OSError, UnicodeError):
        pass
    return values


def memory_and_paging():
    # Byte values avoid ambiguity when reports are compared across machines.
    memory = proc_values("/proc/meminfo", {
        "MemTotal:": "total_bytes", "MemAvailable:": "available_bytes",
        "SwapTotal:": "swap_total_bytes", "SwapFree:": "swap_free_bytes",
        "Dirty:": "dirty_bytes", "Writeback:": "writeback_bytes"}, 1024)
    paging = proc_values("/proc/vmstat", {
        "pswpin": "pswpin", "pswpout": "pswpout", "pgmajfault": "pgmajfault",
        "oom_kill": "oom_kill"})
    return memory, paging


def psi():
    result = {}
    for name in ("cpu", "memory", "io"):
        values = {}
        try:
            for line in Path(f"/proc/pressure/{name}").read_text().splitlines():
                fields = line.split()
                if not fields or fields[0] not in ("some", "full"):
                    continue
                row = {}
                for field in fields[1:]:
                    key, separator, value = field.partition("=")
                    if separator and key in ("avg10", "total"):
                        try:
                            row[key] = float(value) if key == "avg10" else int(value)
                        except ValueError:
                            pass
                if row:
                    values[fields[0]] = row
        except (OSError, UnicodeError):
            continue
        if values:
            result[name] = values
    return result


def recent_marker():
    """Return one new manual marker, if Win+L was pressed in the last 10s."""
    try:
        result = subprocess.run(
            ["journalctl", "-t", "performance-event", "--since", "-10 seconds",
             "-n", "1", "-o", "cat", "--no-pager"],
            capture_output=True, text=True, timeout=1,
            env={**os.environ, "LC_ALL": "C"})
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in reversed(result.stdout.splitlines()):
        try:
            event = json.loads(line)
        except (ValueError, TypeError):
            continue
        if event.get("kind") == "manual":
            return {"id": line, "event": event}
    return None


def load_burst_state(today):
    default = {"date": today.isoformat(), "extra_samples": 0, "last_signal": 0.0,
               "burst_until": 0.0, "last_marker": "", "psi_active": False}
    try:
        state = json.loads(BURST_STATE.read_text())
        if not isinstance(state, dict) or state.get("date") != default["date"]:
            return default
        for key, value in default.items():
            state.setdefault(key, value)
        if not isinstance(state["extra_samples"], int) or state["extra_samples"] < 0:
            state["extra_samples"] = 0
        return state
    except FileNotFoundError:
        return default
    except (OSError, UnicodeError, ValueError, TypeError):
        # Do not risk sending a burst when the accounting file is corrupt.
        default["_state_unusable"] = True
        return default


def save_burst_state(state):
    serializable = {key: value for key, value in state.items() if not key.startswith("_")}
    payload = json.dumps(serializable, separators=(",", ":"), sort_keys=True) + "\n"
    try:
        try:
            if BURST_STATE.read_text() == payload:
                return True
        except FileNotFoundError:
            pass
        temporary = BURST_STATE.with_name(".burst-state.json.tmp")
        temporary.write_text(payload)
        os.replace(temporary, BURST_STATE)
        return True
    except (OSError, UnicodeError):
        # The timeline remains useful if a read-only or transient log path
        # prevents state persistence.
        return False


def burst_status(sample_psi, raw_size, now):
    today = now.date()
    state = load_burst_state(today)
    state_usable = not state.get("_state_unusable", False)
    marker = recent_marker()
    reasons = []
    for resource, label, threshold in (("cpu", "cpu_some", 20.0),
                                        ("memory", "memory_full", 1.0),
                                        ("io", "io_full", 5.0)):
        value = sample_psi.get(resource, {}).get("some" if resource == "cpu" else "full", {}).get("avg10", 0)
        if value >= threshold:
            reasons.append(label)
    psi_trigger = bool(reasons)
    new_trigger = False
    if psi_trigger and not state.get("psi_active", False):
        new_trigger = True
    state["psi_active"] = psi_trigger
    if marker and marker["id"] != state.get("last_marker", ""):
        state["last_marker"] = marker["id"]
        reasons.append("manual_marker")
        new_trigger = True
    if new_trigger:
        state["burst_until"] = max(float(state.get("burst_until", 0)), now.timestamp() + BURST_SECONDS)

    raw_blocked = raw_size is not None and raw_size >= RAW_LIMIT_BYTES
    active = float(state.get("burst_until", 0)) > now.timestamp()
    signal = "idle"
    state_saved = save_burst_state(state) if state_usable else False
    if active and not raw_blocked and state["extra_samples"] < BURST_LIMIT:
        last_signal = float(state.get("last_signal", 0))
        if now.timestamp() - last_signal >= 4:
            # Reserve the sample before signaling so a restart cannot reset
            # the daily budget and overshoot it.
            state["last_signal"] = now.timestamp()
            state["extra_samples"] += 1
            state_saved = state_usable and save_burst_state(state)
            if not state_saved:
                state["extra_samples"] -= 1
                signal = "state_unwritable"
            else:
                try:
                    result = subprocess.run(
                        ["systemctl", "kill", "--kill-whom=main", "--signal=SIGUSR1", "atop.service"],
                        capture_output=True, text=True, timeout=2)
                    signal = "sent" if result.returncode == 0 else "failed"
                except (OSError, subprocess.TimeoutExpired):
                    signal = "timeout"
    elif raw_blocked:
        signal = "raw_limit"
    elif state["extra_samples"] >= BURST_LIMIT:
        signal = "daily_limit"
    return {"active": active, "triggered": bool(reasons), "reasons": reasons,
            "signal": signal, "extra_samples_today": state["extra_samples"],
            "remaining_today": max(0, BURST_LIMIT - state["extra_samples"]),
            "daily_limit": BURST_LIMIT, "raw_size_bytes": raw_size,
            "raw_limit_bytes": RAW_LIMIT_BYTES, "raw_limit_reached": raw_blocked,
            "state_saved": state_saved}


def gpu():
    # systemd runs each query in a separate process with a three-second timeout.
    now = dt.datetime.now().astimezone()
    result = {"timestamp": now.isoformat(timespec="seconds"), "kind": "gpu", "devices": [],
              "disk_counters": {}}
    current_boot = boot_id()
    if current_boot:
        result["boot_id"] = current_boot
    # Keep request-duration counters: Atop's busy-time estimate is not await.
    try:
        for line in Path("/proc/diskstats").read_text().splitlines():
            fields = line.split()
            if len(fields) < 11:
                continue
            name = fields[2]
            if name.startswith(("loop", "ram")) or Path(f"/sys/class/block/{name}/partition").exists():
                continue
            try:
                result["disk_counters"][name] = [int(fields[i]) for i in (3, 7, 6, 10)]
            except (ValueError, IndexError):
                continue
    except (OSError, UnicodeError):
        result["disk_counters_unavailable"] = True
    result["cpu"] = proc_stat()
    memory, paging = memory_and_paging()
    result["memory"] = memory
    result["paging"] = paging
    result["psi"] = psi()
    try:
        raw = LOG_DIR / ("atop_" + now.strftime("%Y%m%d"))
        raw_size = raw.stat().st_size if raw.exists() else None
    except OSError:
        raw_size = None
    result["burst"] = burst_status(result["psi"], raw_size, now)
    class Util(C.Structure):
        _fields_ = [("gpu", C.c_uint), ("memory", C.c_uint)]
    class Memory(C.Structure):
        _fields_ = [("total", C.c_ulonglong), ("free", C.c_ulonglong), ("used", C.c_ulonglong)]
    try:
        lib = C.CDLL("libnvidia-ml.so.1")
        status = lib.nvmlInit_v2()
        if status:
            raise RuntimeError(f"NVML initialization status {status}")
        try:
            count = C.c_uint()
            status = lib.nvmlDeviceGetCount_v2(C.byref(count))
            if status:
                raise RuntimeError(f"NVML device count status {status}")
            for index in range(min(count.value, 16)):
                handle = C.c_void_p()
                if lib.nvmlDeviceGetHandleByIndex_v2(index, C.byref(handle)):
                    continue
                util, memory, temp = Util(), Memory(), C.c_uint()
                entry = {"index": index}
                if lib.nvmlDeviceGetUtilizationRates(handle, C.byref(util)) == 0:
                    entry.update(gpu_pct=util.gpu, memory_activity_pct=util.memory)
                if lib.nvmlDeviceGetMemoryInfo(handle, C.byref(memory)) == 0:
                    entry.update(vram_used_bytes=memory.used, vram_total_bytes=memory.total)
                if lib.nvmlDeviceGetTemperature(handle, 0, C.byref(temp)) == 0:
                    entry["temperature_c"] = temp.value
                result["devices"].append(entry)
        finally:
            lib.nvmlShutdown()
    except (OSError, AttributeError, RuntimeError) as error:
        result["unavailable"] = str(error)
    return result


def interval_statistics(start):
    records = []
    for path in (LOG_DIR / "gpu.jsonl.1.gz", LOG_DIR / "gpu.jsonl"):
        if not path.exists():
            continue
        opener = gzip.open if path.suffix == ".gz" else open
        try:
            with opener(path, "rt") as stream:
                for line in stream:
                    try:
                        record = json.loads(line)
                        if dt.datetime.fromisoformat(record["timestamp"]) >= start:
                            records.append(record)
                    except (ValueError, KeyError, TypeError):
                        continue
        except (OSError, EOFError, UnicodeError):
            # Rotation may replace or temporarily leave a partial gzip file.
            continue
    records.sort(key=lambda row: dt.datetime.fromisoformat(row["timestamp"]).timestamp())
    latencies, activity = {}, {}
    cpu_utilization = []
    psi_max = {}
    for record in records:
        for device in record.get("devices", []):
            if "gpu_pct" in device:
                activity.setdefault(str(device["index"]), []).append(device["gpu_pct"])
        for resource, values in record.get("psi", {}).items():
            for stall, measurements in values.items():
                value = measurements.get("avg10")
                if isinstance(value, (int, float)):
                    psi_max[f"{resource}_{stall}_avg10"] = max(
                        psi_max.get(f"{resource}_{stall}_avg10", 0), value)
    for before, after in zip(records, records[1:]):
        if before.get("boot_id") != after.get("boot_id"):
            continue
        old_cpu = before.get("cpu", {}).get("total", [])
        new_cpu = after.get("cpu", {}).get("total", [])
        if len(old_cpu) == len(CPU_FIELDS) and len(new_cpu) == len(CPU_FIELDS):
            delta = [new - old for new, old in zip(new_cpu, old_cpu)]
            if all(value >= 0 for value in delta):
                total = sum(delta)
                if total:
                    idle = delta[3] + delta[4]
                    cpu_utilization.append(max(0.0, min(100.0, (total - idle) * 100.0 / total)))
        for disk, counters in after.get("disk_counters", {}).items():
            old = before.get("disk_counters", {}).get(disk)
            if old is None or any(n < o for n, o in zip(counters, old)):
                continue
            reads, writes, read_ms, write_ms = [n - o for n, o in zip(counters, old)]
            if reads + writes:
                latencies.setdefault(disk, []).append((read_ms + write_ms) / (reads + writes))
    def stats(values):
        if not values:
            return {"samples": 0}
        values = sorted(values)
        return {"samples": len(values), "p99": values[math.ceil(.99 * len(values)) - 1], "max": values[-1]}
    cpu_summary = stats(cpu_utilization)
    if cpu_utilization:
        cpu_summary["avg_pct"] = sum(cpu_utilization) / len(cpu_utilization)
    return {"disk_await_interval_ms": {k: stats(v) for k, v in latencies.items()},
            "gpu_activity_pct": {k: stats(v) for k, v in activity.items()},
            "systemCPU": cpu_summary, "maxPSI": psi_max}


def once_minute_process_context(lines):
    """Keep a small process snapshot per minute instead of repeating all rows."""
    selected = []
    counts = {}
    first_second = {}
    for line in lines:
        match = re.match(r"^\s*(\d\d:\d\d):(\d\d)", line)
        if not match:
            continue
        minute = match.group(1)
        first_second.setdefault(minute, match.group(2))
        if match.group(2) != first_second[minute]:
            continue
        # atopsar emits the process rows after its timestamped summary. Keep
        # only a bounded top slice for each minute; flagged rows are retained
        # separately below.
        count = counts.get(minute, 0)
        if count >= 24 or "|" not in line:
            continue
        if line.rstrip().endswith(("*", "+")):
            continue
        selected.append(line)
        counts[minute] = count + 1
    return selected


def report():
    now = dt.datetime.now().astimezone()
    start = now - dt.timedelta(minutes=16)
    # The one-minute overlap prevents timer jitter from leaving holes.
    results = []
    for day in sorted({start.date(), now.date()}):
        raw = Path("/var/log/atop") / ("atop_" + day.strftime("%Y%m%d"))
        if not raw.exists():
            continue
        command = ["atopsar", "-cspmdBOGD", "-MxS", "-r", str(raw),
                   "-b", start.strftime("%Y%m%d%H%M%S"),
                   "-e", now.strftime("%Y%m%d%H%M%S")]
        output = subprocess.run(command, capture_output=True, text=True, timeout=45,
                                env={**os.environ, "LC_ALL": "C"})
        if output.returncode:
            results.append({"file": raw.name, "error": output.stderr[-2000:]})
            continue
        lines = output.stdout.splitlines()
        # Native Atop markers identify critical (*) and near-critical (+) rows.
        # Keep flagged rows and one small process slice per minute. Repeating
        # the complete atopsar output made the incident log grow without bound.
        flags = [line for line in lines if line.rstrip().endswith(("*", "+"))]
        results.append({"file": raw.name, "flagged_rows": flags,
                        "top_process_context": once_minute_process_context(lines)})
    journal = subprocess.run(["journalctl", "-t", "performance-event", "--since", start.isoformat(),
                              "--until", now.isoformat(), "-n", "200", "-o", "cat", "--no-pager"],
                             capture_output=True, text=True, timeout=5)
    markers = []
    for line in journal.stdout.splitlines():
        try:
            markers.append(json.loads(line))
        except ValueError:
            continue
    return {"timestamp": stamp(), "kind": "automatic_report", "from": start.isoformat(),
            "to": now.isoformat(), "reports": results,
            "manual_markers": markers,
            "interval_statistics": interval_statistics(start),
            "interpretation": "Resource flags identify investigation candidates, not proven causes. "
                              "disk_await_interval_ms is the percentile of interval-average request durations, "
                              "not individual-I/O or UI P99. Atop avserv is its busy-time-based estimate."}


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "mark":
        message = " ".join(sys.argv[2:])[:240] or "slowdown started now"
        event = json.dumps({"timestamp": stamp(), "kind": "manual", "message": message})
        subprocess.run(["logger", "-t", "performance-event", "--", event], check=True, timeout=3)
        try:
            subprocess.run(["notify-send", "-t", "1800", "Slowdown marked",
                            "Performance history is already recording."], timeout=3,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            pass
        print(event)
    elif command in ("gpu", "report"):
        print(json.dumps(gpu() if command == "gpu" else report(), separators=(",", ":")), flush=True)
    else:
        raise SystemExit("usage: performance-event {mark [description]|gpu|report}")


if __name__ == "__main__":
    main()
