#!/bin/sh

if test "$(id -u)" -eq 0; then
	exec openvt --force --switch --console=2 -- \
		systemd-run --wait --collect --pipe \
		login -f hypr --shell /usr/local/bin/desktop
fi

# login(1)'s --shell override leaks this desktop launcher into SHELL.  Keep
# terminal emulators from trying to run the launcher as an interactive shell.
export SHELL=/bin/bash

# Hyprland enables detailed stdout logs in its config; journald persists them.
exec systemd-cat --identifier=hyprland start-hyprland
