#!/bin/bash

if test "$(id -u)" -eq 0; then
	exec openvt --force --switch --wait --console=2 -- \
		systemd-run --wait --collect --pipe \
		login -f hypr --shell /usr/local/bin/desktop
fi

set -o pipefail

logger --tag hyprland-session \
	"started user=$(id -un) boot_id=$(cat /proc/sys/kernel/random/boot_id)"

start-hyprland 2>&1 | systemd-cat --identifier=hyprland
STATUS=${PIPESTATUS[0]}

logger --tag hyprland-session "stopped status=$STATUS"
exit "$STATUS"
