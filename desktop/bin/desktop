#!/bin/sh
modprobe -r nvidia_drm && modprobe nvidia-current-drm modeset=1
exec openvt --force --switch --wait --console=2 -- systemd-run --wait --collect --uid=hypr --property=PAMName=login --property=TTYPath=/dev/tty2 --property=StandardInput=tty-force --property=StandardOutput=tty --property=StandardError=tty start-hyprland
