#!/usr/bin/python3

import fcntl
import json
import os
import signal
import socket
import subprocess
import time
from dataclasses import dataclass

import cairo
import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")

from gi.repository import Gdk, GLib, Gtk, GtkLayerShell


FADE_MS = 80
REFRESH_MS = 30
RECONNECT_MS = 1000
REFRESH_EVENTS = {
    "activewindowv2",
    "workspace",
    "workspacev2",
    "focusedmon",
    "openwindow",
    "closewindow",
    "movewindow",
    "movewindowv2",
    "fullscreen",
    "configreloaded",
}


@dataclass(frozen=True)
class Target:
    address: str
    side: str
    x: int
    y: int
    width: int
    height: int
    position: int


def hypr_json(command):
    try:
        result = subprocess.run(
            ("hyprctl", "-j", command),
            check=True,
            capture_output=True,
            text=True,
        )
        return json.loads(result.stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return None


def desktop_state():
    monitors = hypr_json("monitors")
    workspaces = hypr_json("workspaces")
    clients = hypr_json("clients")
    if monitors is None or workspaces is None or clients is None:
        return None
    return {
        "monitors": {monitor["name"]: monitor for monitor in monitors},
        "workspaces": {workspace["id"]: workspace for workspace in workspaces},
        "clients": clients,
    }


def clipped_targets(state, monitor_name):
    monitor = state["monitors"][monitor_name]
    workspace_id = monitor["activeWorkspace"]["id"]
    workspace = state["workspaces"].get(workspace_id)
    if not workspace or workspace.get("hasfullscreen", False):
        return []

    left, top = monitor["x"], monitor["y"]
    right, bottom = left + monitor["width"], top + monitor["height"]
    active = workspace.get("lastwindow")
    left_targets, right_targets = [], []

    for client in state["clients"]:
        if (
            not client.get("mapped", False)
            or client.get("hidden", False)
            or client.get("floating", False)
            or client.get("workspace", {}).get("id") != workspace_id
            or client["address"] == active
        ):
            continue

        client_left, client_top = client["at"]
        width, height = client["size"]
        client_right = client_left + width
        visible_top = max(client_top, top)
        visible_height = min(client_top + height, bottom) - visible_top
        if visible_height <= 0:
            continue

        if client_left < left < client_right:
            left_targets.append(
                Target(
                    client["address"],
                    "left",
                    0,
                    visible_top - top,
                    min(client_right, right) - left,
                    visible_height,
                    client_left,
                )
            )
        if client_left < right < client_right:
            visible_left = max(client_left, left)
            right_targets.append(
                Target(
                    client["address"],
                    "right",
                    visible_left - left,
                    visible_top - top,
                    right - visible_left,
                    visible_height,
                    client_left,
                )
            )

    targets = []
    if left_targets:
        targets.append(max(left_targets, key=lambda target: target.position))
    if right_targets:
        targets.append(min(right_targets, key=lambda target: target.position))
    return targets


def focus_window(address):
    selector = json.dumps(f"address:{address}")
    subprocess.run(
        ("hyprctl", "dispatch", f"hl.dsp.focus({{ window = {selector} }})"),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


class MonitorCanvas(Gtk.DrawingArea):
    def __init__(self, geometry):
        super().__init__()
        self.geometry = geometry
        self.targets = []
        self.hovered = None
        self.draw_target = None
        self.opacity = 0.0
        self.pressed = False
        self.fade = None
        self.fade_source = None
        self.pointer_source = None

        self.set_size_request(geometry.width, geometry.height)
        self.set_app_paintable(True)
        self.add_events(
            Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
            | Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
        )
        self.connect("realize", lambda *_: self.apply_input_region())
        self.connect("motion-notify-event", self.on_motion)
        self.connect("leave-notify-event", self.on_leave)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("draw", self.on_draw)
        self.get_accessible().set_name("Clipped window navigation")

    def set_targets(self, targets, pointer):
        if targets != self.targets:
            self.targets = targets
            self.apply_input_region()
        x = pointer["x"] - self.geometry.x if pointer else -1
        y = pointer["y"] - self.geometry.y if pointer else -1
        self.set_hovered(self.target_at(x, y))

    def apply_input_region(self):
        if not self.get_realized():
            return
        region = cairo.Region()
        for target in self.targets:
            region.union(
                cairo.RectangleInt(
                    target.x,
                    target.y,
                    target.width,
                    target.height,
                )
            )
        surface = self.get_toplevel().get_window()
        surface.input_shape_combine_region(region, 0, 0)
        surface.get_display().flush()

    def target_at(self, x, y):
        return next(
            (
                target
                for target in self.targets
                if target.x <= x < target.x + target.width
                and target.y <= y < target.y + target.height
            ),
            None,
        )

    def set_hovered(self, target):
        old_address = self.hovered.address if self.hovered else None
        new_address = target.address if target else None
        self.hovered = target
        if old_address == new_address:
            if target:
                self.draw_target = target
                self.queue_draw()
            return
        if target:
            self.draw_target = target
        self.animate_to(1.0 if target else 0.0)

    def animate_to(self, opacity):
        self.fade = (time.monotonic(), self.opacity, opacity)
        if self.fade_source is None:
            self.fade_source = GLib.timeout_add(16, self.animate)

    def animate(self):
        started, initial, target = self.fade
        progress = min(1.0, (time.monotonic() - started) * 1000 / FADE_MS)
        eased = progress * (2.0 - progress)
        self.opacity = initial + (target - initial) * eased
        self.queue_draw()
        if progress < 1.0:
            return GLib.SOURCE_CONTINUE
        if self.opacity == 0.0:
            self.draw_target = None
        self.fade_source = None
        return GLib.SOURCE_REMOVE

    def on_motion(self, _widget, event):
        if self.pointer_source is not None:
            GLib.source_remove(self.pointer_source)
            self.pointer_source = None
        self.set_hovered(self.target_at(event.x, event.y))
        return Gdk.EVENT_PROPAGATE

    def on_leave(self, _widget, _event):
        if self.pointer_source is None:
            self.pointer_source = GLib.timeout_add(20, self.reconcile_pointer)
        return Gdk.EVENT_PROPAGATE

    def reconcile_pointer(self):
        pointer = hypr_json("cursorpos")
        x = pointer["x"] - self.geometry.x if pointer else -1
        y = pointer["y"] - self.geometry.y if pointer else -1
        self.set_hovered(self.target_at(x, y))
        self.pointer_source = None
        return GLib.SOURCE_REMOVE

    def on_press(self, _widget, event):
        self.pressed = event.button == 1 and self.target_at(event.x, event.y) is not None
        self.queue_draw()
        return Gdk.EVENT_STOP

    def on_release(self, _widget, event):
        target = self.target_at(event.x, event.y)
        clicked = event.button == 1 and self.pressed and target
        self.pressed = False
        self.queue_draw()
        if clicked:
            focus_window(target.address)
        return Gdk.EVENT_STOP

    def on_draw(self, _widget, context):
        target = self.draw_target
        if not target or self.opacity <= 0.0:
            return True

        context.save()
        context.rectangle(target.x, target.y, target.width, target.height)
        context.clip()

        start = target.x if target.side == "left" else target.x + target.width
        end = target.x + target.width if target.side == "left" else target.x
        gradient = cairo.LinearGradient(start, 0, end, 0)
        strength = 1.15 if self.pressed else 1.0
        gradient.add_color_stop_rgba(
            0, 7 / 255, 10 / 255, 16 / 255, 0.34 * self.opacity * strength
        )
        gradient.add_color_stop_rgba(
            0.58, 7 / 255, 10 / 255, 16 / 255, 0.08 * self.opacity
        )
        gradient.add_color_stop_rgba(
            1, 7 / 255, 10 / 255, 16 / 255, 0.02 * self.opacity
        )
        context.set_source(gradient)
        context.paint()

        center_x = target.x + target.width / 2
        center_y = target.y + target.height / 2
        direction = -1 if target.side == "left" else 1
        context.set_source_rgba(245 / 255, 248 / 255, 1, 0.92 * self.opacity)
        context.set_line_width(2.6)
        context.set_line_cap(cairo.LINE_CAP_ROUND)
        context.set_line_join(cairo.LINE_JOIN_ROUND)
        context.move_to(center_x - direction * 4.5, center_y - 9)
        context.line_to(center_x + direction * 4.5, center_y)
        context.line_to(center_x - direction * 4.5, center_y + 9)
        context.stroke()
        context.restore()
        return True


class TapeEdges:
    def __init__(self):
        self.surfaces = {}
        self.event_socket = None
        self.event_buffer = ""
        self.refresh_source = None
        self.reconnect_source = None
        active = hypr_json("activewindow") or {}
        self.last_active = active.get("address", "").removeprefix("0x")
        self.display = Gdk.Display.get_default()
        self.display.connect("monitor-added", self.rebuild)
        self.display.connect("monitor-removed", self.rebuild)
        self.install_style()
        self.connect_events()
        self.rebuild()

    @staticmethod
    def install_style():
        provider = Gtk.CssProvider()
        provider.load_from_data(b"window, drawingarea { background: transparent; }")
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def rebuild(self, *_args):
        for window, _canvas in self.surfaces.values():
            window.destroy()
        self.surfaces = {}

        state = desktop_state()
        if not state:
            return
        for index in range(self.display.get_n_monitors()):
            monitor = self.display.get_monitor(index)
            name = self.monitor_name(monitor, state)
            if name:
                self.surfaces[name] = self.make_surface(monitor)
        self.refresh(state)

    @staticmethod
    def monitor_name(gdk_monitor, state):
        geometry = gdk_monitor.get_geometry()
        for monitor in state["monitors"].values():
            if (
                monitor["x"] == geometry.x
                and monitor["y"] == geometry.y
                and monitor["width"] == geometry.width
                and monitor["height"] == geometry.height
            ):
                return monitor["name"]
        return None

    @staticmethod
    def make_surface(monitor):
        window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        window.set_app_paintable(True)
        window.set_decorated(False)
        window.set_accept_focus(False)

        GtkLayerShell.init_for_window(window)
        GtkLayerShell.set_namespace(window, "tape-edges")
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_monitor(window, monitor)
        GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_exclusive_zone(window, 0)
        for edge in (
            GtkLayerShell.Edge.TOP,
            GtkLayerShell.Edge.RIGHT,
            GtkLayerShell.Edge.BOTTOM,
            GtkLayerShell.Edge.LEFT,
        ):
            GtkLayerShell.set_anchor(window, edge, True)

        canvas = MonitorCanvas(monitor.get_geometry())
        window.add(canvas)
        window.show_all()
        return window, canvas

    def refresh(self, state=None):
        state = state or desktop_state()
        if not state:
            return
        pointer = hypr_json("cursorpos")
        for name, (_window, canvas) in self.surfaces.items():
            canvas.set_targets(clipped_targets(state, name), pointer)

    def schedule_refresh(self):
        if self.refresh_source is None:
            self.refresh_source = GLib.timeout_add(REFRESH_MS, self.run_refresh)

    def run_refresh(self):
        self.refresh_source = None
        self.refresh()
        return GLib.SOURCE_REMOVE

    def connect_events(self):
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        event_socket = None
        try:
            path = os.path.join(runtime, "hypr", signature, ".socket2.sock")
            event_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            event_socket.connect(path)
            event_socket.setblocking(False)
        except (OSError, TypeError):
            if event_socket is not None:
                event_socket.close()
            self.reconnect_later()
            return

        self.event_socket = event_socket
        self.event_buffer = ""
        GLib.io_add_watch(
            event_socket,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            self.on_events,
        )

    def reconnect_later(self):
        if self.reconnect_source is None:
            self.reconnect_source = GLib.timeout_add(
                RECONNECT_MS,
                self.reconnect,
            )

    def reconnect(self):
        self.reconnect_source = None
        if self.event_socket is None:
            self.connect_events()
        return GLib.SOURCE_REMOVE

    def on_events(self, event_socket, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            return self.disconnect_events()
        try:
            chunk = event_socket.recv(65536)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            return self.disconnect_events()
        if not chunk:
            return self.disconnect_events()

        self.event_buffer += chunk.decode(errors="replace")
        lines = self.event_buffer.split("\n")
        self.event_buffer = lines.pop()
        refresh = False
        rebuild = False
        for line in lines:
            event, _, payload = line.partition(">>")
            if event not in REFRESH_EVENTS:
                continue
            if event == "activewindowv2":
                address = payload.split(",", 1)[0].removeprefix("0x")
                if address == self.last_active:
                    continue
                self.last_active = address
            refresh = True
            rebuild |= event == "configreloaded"

        if rebuild:
            GLib.idle_add(self.rebuild)
        elif refresh:
            self.schedule_refresh()
        return GLib.SOURCE_CONTINUE

    def disconnect_events(self):
        if self.event_socket is not None:
            self.event_socket.close()
            self.event_socket = None
        self.reconnect_later()
        return GLib.SOURCE_REMOVE


def main():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    lock = open(os.path.join(runtime, "tape-edges.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    TapeEdges()
    Gtk.main()


if __name__ == "__main__":
    main()
