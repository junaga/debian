#!/usr/bin/python3

import fcntl
import json
import os
import signal
import socket
import subprocess

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")

from gi.repository import Gdk, GLib, Gtk, GtkLayerShell


REFRESH_DELAY_MS = 30
RECONNECT_DELAY_MS = 1000
HOVER_RECHECK_MS = 20
REFRESH_EVENTS = {
    "activewindowv2",
    "workspace",
    "workspacev2",
    "focusedmon",
    "openwindow",
    "closewindow",
    "movewindow",
    "movewindowv2",
    "fullscreen",
    "configreloaded",
}


def hyprctl(*arguments):
    return subprocess.run(
        ("hyprctl", *arguments),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def hyprctl_json(command):
    try:
        result = subprocess.run(
            ("hyprctl", "-j", command),
            check=True,
            capture_output=True,
            text=True,
        )
        return json.loads(result.stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return None


def desktop_state():
    monitors = hyprctl_json("monitors")
    workspaces = hyprctl_json("workspaces")
    clients = hyprctl_json("clients")
    if monitors is None or workspaces is None or clients is None:
        return None

    return {
        "monitors": {monitor["name"]: monitor for monitor in monitors},
        "workspaces": {workspace["id"]: workspace for workspace in workspaces},
        "clients": clients,
    }


def clipped_targets(state, monitor_name):
    monitor = state["monitors"].get(monitor_name)
    if not monitor:
        return []

    workspace_id = monitor["activeWorkspace"]["id"]
    workspace = state["workspaces"].get(workspace_id)
    if not workspace or workspace.get("hasfullscreen", False):
        return []

    monitor_left = monitor["x"]
    monitor_top = monitor["y"]
    monitor_right = monitor_left + monitor["width"]
    monitor_bottom = monitor_top + monitor["height"]
    current_address = workspace.get("lastwindow", "")
    candidates = {"left": [], "right": []}

    for client in state["clients"]:
        if (
            not client.get("mapped", False)
            or client.get("hidden", False)
            or client.get("floating", False)
            or client.get("workspace", {}).get("id") != workspace_id
            or client["address"] == current_address
        ):
            continue

        client_left, client_top = client["at"]
        client_width, client_height = client["size"]
        client_right = client_left + client_width
        client_bottom = client_top + client_height
        visible_top = max(client_top, monitor_top)
        visible_bottom = min(client_bottom, monitor_bottom)
        visible_height = visible_bottom - visible_top
        if visible_height <= 0:
            continue

        if client_left < monitor_left < client_right:
            visible_right = min(client_right, monitor_right)
            candidates["left"].append(
                {
                    "address": client["address"],
                    "side": "left",
                    "top": visible_top - monitor_top,
                    "width": visible_right - monitor_left,
                    "height": visible_height,
                    "position": client_left,
                }
            )

        if client_left < monitor_right < client_right:
            visible_left = max(client_left, monitor_left)
            candidates["right"].append(
                {
                    "address": client["address"],
                    "side": "right",
                    "top": visible_top - monitor_top,
                    "width": monitor_right - visible_left,
                    "height": visible_height,
                    "position": client_left,
                }
            )

    targets = []
    if candidates["left"]:
        targets.append(max(candidates["left"], key=lambda target: target["position"]))
    if candidates["right"]:
        targets.append(min(candidates["right"], key=lambda target: target["position"]))
    return targets


def focus_window(address):
    window = json.dumps(f"address:{address}")
    hyprctl("dispatch", f"hl.dsp.focus({{ window = {window} }})")


class TapeEdges:
    def __init__(self):
        self.controls = {}
        self.event_socket = None
        self.event_buffer = ""
        self.refresh_scheduled = False
        active_window = hyprctl_json("activewindow") or {}
        self.last_active_address = active_window.get("address", "").removeprefix("0x")
        self.display = Gdk.Display.get_default()
        self.display.connect("monitor-added", self.rebuild)
        self.display.connect("monitor-removed", self.rebuild)
        self.install_style()
        self.connect_event_socket()
        self.rebuild()

    @staticmethod
    def install_style():
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            window {
                background: transparent;
            }

            button {
                padding: 0;
                color: transparent;
                background: transparent;
                border: 0;
                border-radius: 0;
                box-shadow: none;
                outline: none;
                font-size: 40px;
                font-weight: 300;
                transition: 80ms ease;
            }

            button.left.hovered {
                color: rgba(245, 248, 255, 0.92);
                background-image: linear-gradient(
                    to right,
                    rgba(7, 10, 16, 0.34),
                    rgba(7, 10, 16, 0.08) 58%,
                    rgba(7, 10, 16, 0.02)
                );
            }

            button.right.hovered {
                color: rgba(245, 248, 255, 0.92);
                background-image: linear-gradient(
                    to left,
                    rgba(7, 10, 16, 0.34),
                    rgba(7, 10, 16, 0.08) 58%,
                    rgba(7, 10, 16, 0.02)
                );
            }

            button:active {
                color: rgba(255, 255, 255, 1.0);
                background-color: rgba(210, 222, 245, 0.10);
            }
            """
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def rebuild(self, *_arguments):
        for control in self.controls.values():
            if control["hover_source"] is not None:
                GLib.source_remove(control["hover_source"])
            control["window"].destroy()
        self.controls = {}

        state = desktop_state()
        if not state:
            return

        for index in range(self.display.get_n_monitors()):
            gdk_monitor = self.display.get_monitor(index)
            monitor_name = self.match_monitor(gdk_monitor, state)
            if not monitor_name:
                continue

            for side in ("left", "right"):
                self.controls[(monitor_name, side)] = self.make_control(
                    gdk_monitor,
                    side,
                )

        self.refresh()

    def refresh(self):
        state = desktop_state()
        if not state:
            return

        pointer = hyprctl_json("cursorpos")
        desired = {}
        for monitor_name in state["monitors"]:
            for target in clipped_targets(state, monitor_name):
                desired[(monitor_name, target["side"])] = target

        for key, control in self.controls.items():
            target = desired.get(key)
            signature = (
                target["address"],
                target["top"],
                target["width"],
                target["height"],
            ) if target else None
            if signature == control["signature"]:
                continue

            control["signature"] = signature
            if target is None:
                control["address"] = None
                control["rect"] = None
                self.set_hovered(control, False)
                control["window"].hide()
                continue

            monitor_name, side = key
            monitor = state["monitors"][monitor_name]
            left = (
                monitor["x"]
                if side == "left"
                else monitor["x"] + monitor["width"] - target["width"]
            )
            control["address"] = target["address"]
            control["rect"] = (
                left,
                monitor["y"] + target["top"],
                target["width"],
                target["height"],
            )
            GtkLayerShell.set_margin(
                control["window"],
                GtkLayerShell.Edge.TOP,
                target["top"],
            )
            control["button"].set_size_request(
                target["width"],
                target["height"],
            )
            control["window"].show_all()
            self.set_hovered(
                control,
                self.pointer_inside(pointer, control["rect"]),
            )

    @staticmethod
    def match_monitor(gdk_monitor, state):
        geometry = gdk_monitor.get_geometry()
        for monitor in state["monitors"].values():
            if (
                monitor["x"] == geometry.x
                and monitor["y"] == geometry.y
                and monitor["width"] == geometry.width
                and monitor["height"] == geometry.height
            ):
                return monitor["name"]
        return None

    @staticmethod
    def make_control(monitor, side):
        edge = GtkLayerShell.Edge.LEFT if side == "left" else GtkLayerShell.Edge.RIGHT

        window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        window.set_app_paintable(True)
        window.set_decorated(False)
        window.set_resizable(False)
        window.set_accept_focus(False)

        GtkLayerShell.init_for_window(window)
        GtkLayerShell.set_namespace(window, "tape-edges")
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_monitor(window, monitor)
        GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_exclusive_zone(window, 0)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(window, edge, True)
        GtkLayerShell.set_margin(window, edge, 0)

        button = Gtk.Button(label="‹" if side == "left" else "›")
        button.set_can_focus(False)
        button.set_focus_on_click(False)
        button.get_style_context().add_class(side)
        button.get_accessible().set_name(
            "Bring previous window into view"
            if side == "left"
            else "Bring next window into view"
        )
        control = {
            "window": window,
            "button": button,
            "address": None,
            "rect": None,
            "signature": None,
            "hover_source": None,
        }
        button.connect(
            "clicked",
            lambda _button: focus_window(control["address"])
            if control["address"]
            else None,
        )
        button.connect("enter-notify-event", TapeEdges.pointer_entered, control)
        button.connect("leave-notify-event", TapeEdges.pointer_left, control)
        window.add(button)
        return control

    @staticmethod
    def pointer_inside(pointer, rect):
        if not pointer or not rect:
            return False
        left, top, width, height = rect
        return (
            left <= pointer["x"] < left + width
            and top <= pointer["y"] < top + height
        )

    @staticmethod
    def set_hovered(control, hovered):
        context = control["button"].get_style_context()
        if hovered:
            context.add_class("hovered")
        else:
            context.remove_class("hovered")

    @staticmethod
    def pointer_entered(_button, _event, control):
        if control["hover_source"] is not None:
            GLib.source_remove(control["hover_source"])
            control["hover_source"] = None
        TapeEdges.set_hovered(control, True)
        return Gdk.EVENT_PROPAGATE

    @staticmethod
    def pointer_left(_button, event, control):
        if event.detail == Gdk.NotifyType.INFERIOR:
            return Gdk.EVENT_PROPAGATE
        if control["hover_source"] is None:
            control["hover_source"] = GLib.timeout_add(
                HOVER_RECHECK_MS,
                TapeEdges.recheck_hover,
                control,
            )
        return Gdk.EVENT_PROPAGATE

    @staticmethod
    def recheck_hover(control):
        pointer = hyprctl_json("cursorpos")
        TapeEdges.set_hovered(
            control,
            TapeEdges.pointer_inside(pointer, control["rect"]),
        )
        control["hover_source"] = None
        return GLib.SOURCE_REMOVE

    def schedule_refresh(self):
        if not self.refresh_scheduled:
            self.refresh_scheduled = True
            GLib.timeout_add(REFRESH_DELAY_MS, self.run_scheduled_refresh)

    def run_scheduled_refresh(self):
        self.refresh_scheduled = False
        self.refresh()
        return GLib.SOURCE_REMOVE

    def connect_event_socket(self):
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        runtime_directory = os.environ.get("XDG_RUNTIME_DIR")
        if not signature or not runtime_directory:
            GLib.timeout_add(RECONNECT_DELAY_MS, self.retry_event_socket)
            return

        path = os.path.join(
            runtime_directory,
            "hypr",
            signature,
            ".socket2.sock",
        )
        event_socket = None
        try:
            event_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            event_socket.connect(path)
            event_socket.setblocking(False)
        except OSError:
            if event_socket is not None:
                event_socket.close()
            GLib.timeout_add(RECONNECT_DELAY_MS, self.retry_event_socket)
            return

        self.event_socket = event_socket
        self.event_buffer = ""
        GLib.io_add_watch(
            event_socket,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            self.handle_event_socket,
        )

    def retry_event_socket(self):
        if self.event_socket is None:
            self.connect_event_socket()
        return GLib.SOURCE_REMOVE

    def handle_event_socket(self, event_socket, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.disconnect_event_socket()
            return GLib.SOURCE_REMOVE

        try:
            chunk = event_socket.recv(65536)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self.disconnect_event_socket()
            return GLib.SOURCE_REMOVE

        if not chunk:
            self.disconnect_event_socket()
            return GLib.SOURCE_REMOVE

        self.event_buffer += chunk.decode(errors="replace")
        lines = self.event_buffer.split("\n")
        self.event_buffer = lines.pop()
        refresh_needed = False
        for line in lines:
            event, _separator, payload = line.partition(">>")
            if event not in REFRESH_EVENTS:
                continue
            if event == "activewindowv2":
                address = payload.split(",", 1)[0].removeprefix("0x")
                if address == self.last_active_address:
                    continue
                self.last_active_address = address
            refresh_needed = True

        if refresh_needed:
            self.schedule_refresh()

        return GLib.SOURCE_CONTINUE

    def disconnect_event_socket(self):
        if self.event_socket is not None:
            self.event_socket.close()
            self.event_socket = None
        GLib.timeout_add(RECONNECT_DELAY_MS, self.retry_event_socket)


def main():
    runtime_directory = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    lock = open(os.path.join(runtime_directory, "tape-edges.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    signal.signal(signal.SIGTERM, lambda *_arguments: Gtk.main_quit())
    TapeEdges()
    Gtk.main()


if __name__ == "__main__":
    main()
