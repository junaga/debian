#!/usr/bin/python3

import fcntl
import json
import os
import signal
import socket
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")

from gi.repository import Gdk, GLib, Gtk, GtkLayerShell


EDGE_SENSOR_WIDTH = 16
HANDLE_WIDTH = 48
HANDLE_HEIGHT = 132
EDGE_MARGIN = 0
HANDLE_VERTICAL_PADDING = 28
REVEAL_DELAY_MS = 90
HIDE_DELAY_MS = 180
REFRESH_DELAY_MS = 30
RECONNECT_DELAY_MS = 1000
REFRESH_EVENTS = (
    "activewindow",
    "activewindowv2",
    "workspace",
    "workspacev2",
    "focusedmon",
    "openwindow",
    "closewindow",
    "movewindow",
    "fullscreen",
    "configreloaded",
)


def hyprctl(*arguments):
    return subprocess.run(
        ("hyprctl", *arguments),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def hyprctl_json(command):
    try:
        result = subprocess.run(
            ("hyprctl", "-j", command),
            check=True,
            capture_output=True,
            text=True,
        )
        return json.loads(result.stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return None


def desktop_state():
    monitors = hyprctl_json("monitors")
    workspaces = hyprctl_json("workspaces")
    clients = hyprctl_json("clients")
    if monitors is None or workspaces is None or clients is None:
        return None

    return {
        "monitors": {monitor["name"]: monitor for monitor in monitors},
        "workspaces": {workspace["id"]: workspace for workspace in workspaces},
        "clients": clients,
    }


def navigation_targets(state, monitor_name):
    monitor = state["monitors"].get(monitor_name)
    if not monitor:
        return None, None, False

    workspace_id = monitor["activeWorkspace"]["id"]
    workspace = state["workspaces"].get(workspace_id)
    if not workspace or workspace.get("hasfullscreen", False):
        return None, None, True

    columns = {}
    for client in state["clients"]:
        if (
            client.get("mapped", False)
            and not client.get("hidden", False)
            and not client.get("floating", False)
            and client.get("workspace", {}).get("id") == workspace_id
        ):
            columns.setdefault(client["at"][0], []).append(client)

    if not columns:
        return None, None, False

    ordered_columns = sorted(columns)
    current_address = workspace.get("lastwindow", "")
    current_client = next(
        (
            client
            for clients in columns.values()
            for client in clients
            if client["address"] == current_address
        ),
        None,
    )

    if current_client:
        current_column = current_client["at"][0]
    else:
        monitor_center = monitor["x"] + monitor["width"] / 2
        current_column = min(
            ordered_columns,
            key=lambda x: abs(
                x + max(client["size"][0] for client in columns[x]) / 2
                - monitor_center
            ),
        )

    column_index = ordered_columns.index(current_column)

    def address_at(index):
        if not 0 <= index < len(ordered_columns):
            return None

        clients = columns[ordered_columns[index]]
        return min(
            clients,
            key=lambda client: (
                client.get("focusHistoryID", 2**31),
                client["at"][1],
            ),
        )["address"]

    return address_at(column_index - 1), address_at(column_index + 1), False


def focus_window(address):
    if not address:
        return

    # Addresses are produced by Hyprland, and JSON quoting is valid Lua quoting.
    window = json.dumps(f"address:{address}")
    hyprctl("dispatch", f"hl.dsp.focus({{ window = {window} }})")


def step(monitor_name, direction):
    state = desktop_state()
    if not state:
        return

    left, right, fullscreen = navigation_targets(state, monitor_name)
    if not fullscreen:
        focus_window(left if direction == "left" else right)


class TapeEdges:
    def __init__(self):
        self.controls = {}
        self.event_socket = None
        self.event_buffer = ""
        self.refresh_scheduled = False
        self.display = Gdk.Display.get_default()
        self.display.connect("monitor-added", self.rebuild)
        self.display.connect("monitor-removed", self.rebuild)
        self.install_style()
        self.rebuild()
        self.connect_event_socket()

    @staticmethod
    def install_style():
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            window {
                background: transparent;
            }

            button {
                min-width: 48px;
                min-height: 132px;
                padding: 0;
                color: transparent;
                background: transparent;
                border: 0;
                box-shadow: none;
                font-size: 32px;
                font-weight: 300;
                transition: 120ms ease;
            }

            button.revealed {
                min-width: 48px;
                color: rgba(255, 225, 178, 0.88);
                background: rgba(8, 6, 3, 0.74);
                box-shadow:
                    inset 0 0 0 1px rgba(255, 204, 128, 0.18),
                    0 4px 18px rgba(0, 0, 0, 0.26);
            }

            button.left.revealed {
                border-radius: 0 20px 20px 0;
            }

            button.right.revealed {
                border-radius: 20px 0 0 20px;
            }

            button.revealed:hover {
                color: rgba(255, 234, 201, 1.0);
                background: rgba(16, 11, 5, 0.82);
                box-shadow:
                    inset 0 0 0 1px rgba(255, 210, 138, 0.30),
                    0 5px 22px rgba(0, 0, 0, 0.32);
            }

            button.revealed:active {
                color: rgba(255, 239, 214, 1.0);
                background: rgba(255, 184, 77, 0.22);
            }
            """
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def rebuild(self, *_arguments):
        for control in self.controls.values():
            control["window"].destroy()
        self.controls = {}

        state = desktop_state()
        if not state:
            return

        for index in range(self.display.get_n_monitors()):
            gdk_monitor = self.display.get_monitor(index)
            monitor_name = self.match_monitor(gdk_monitor, state)
            if not monitor_name:
                continue

            for side in ("left", "right"):
                self.controls[(monitor_name, side)] = self.make_control(
                    gdk_monitor, monitor_name, side
                )

        self.refresh()

    @staticmethod
    def match_monitor(gdk_monitor, state):
        geometry = gdk_monitor.get_geometry()
        for monitor in state["monitors"].values():
            if (
                monitor["x"] == geometry.x
                and monitor["y"] == geometry.y
                and monitor["width"] == geometry.width
                and monitor["height"] == geometry.height
            ):
                return monitor["name"]
        return None

    def make_control(self, monitor, monitor_name, side):
        geometry = monitor.get_geometry()

        window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        window.set_app_paintable(True)
        window.set_decorated(False)
        window.set_resizable(False)

        GtkLayerShell.init_for_window(window)
        GtkLayerShell.set_namespace(window, "tape-edges")
        GtkLayerShell.set_layer(window, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_monitor(window, monitor)
        GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_exclusive_zone(window, 0)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.BOTTOM, True)
        edge = GtkLayerShell.Edge.LEFT if side == "left" else GtkLayerShell.Edge.RIGHT
        GtkLayerShell.set_anchor(window, edge, True)
        GtkLayerShell.set_margin(window, edge, EDGE_MARGIN)

        rail = Gtk.Fixed()
        rail.set_size_request(EDGE_SENSOR_WIDTH, -1)

        button = Gtk.Button(label="‹" if side == "left" else "›")
        button.set_size_request(HANDLE_WIDTH, HANDLE_HEIGHT)
        button.set_no_show_all(True)
        button.set_can_focus(False)
        button.set_focus_on_click(False)
        button.set_sensitive(False)
        button.get_style_context().add_class(side)
        button.get_accessible().set_name(
            "Previous window" if side == "left" else "Next window"
        )
        button.connect(
            "clicked",
            lambda _button: step(monitor_name, side),
        )
        rail.put(button, 0, HANDLE_VERTICAL_PADDING)
        window.add(rail)
        window.add_events(
            Gdk.EventMask.ENTER_NOTIFY_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
        )

        control = {
            "window": window,
            "rail": rail,
            "button": button,
            "height": geometry.height,
            "handle_y": HANDLE_VERTICAL_PADDING,
            "pointer_y": geometry.height / 2,
            "reveal_source": None,
            "hide_source": None,
            "revealed": False,
        }
        window.connect("enter-notify-event", self.schedule_reveal, control)
        window.connect("leave-notify-event", self.schedule_hide, control)
        window.connect("motion-notify-event", self.track_pointer, control)

        return control

    @staticmethod
    def schedule_reveal(_window, event, control):
        if control["hide_source"] is not None:
            GLib.source_remove(control["hide_source"])
            control["hide_source"] = None

        control["pointer_y"] = event.y
        if not control["revealed"] and control["reveal_source"] is None:
            control["reveal_source"] = GLib.timeout_add(
                REVEAL_DELAY_MS,
                TapeEdges.reveal_control,
                control,
            )
        return Gdk.EVENT_PROPAGATE

    @staticmethod
    def reveal_control(control):
        TapeEdges.position_handle(control, control["pointer_y"])
        control["rail"].set_size_request(HANDLE_WIDTH, -1)
        button = control["button"]
        button.get_style_context().add_class("revealed")
        button.set_sensitive(True)
        button.show()
        control["revealed"] = True
        control["reveal_source"] = None
        return GLib.SOURCE_REMOVE

    @staticmethod
    def track_pointer(_window, event, control):
        control["pointer_y"] = event.y
        if control["revealed"]:
            handle_y = control["handle_y"]
            if (
                event.y < handle_y + HANDLE_HEIGHT * 0.25
                or event.y > handle_y + HANDLE_HEIGHT * 0.75
            ):
                TapeEdges.position_handle(control, event.y)
        return Gdk.EVENT_PROPAGATE

    @staticmethod
    def position_handle(control, pointer_y):
        maximum_y = control["height"] - HANDLE_HEIGHT - HANDLE_VERTICAL_PADDING
        handle_y = round(
            max(
                HANDLE_VERTICAL_PADDING,
                min(pointer_y - HANDLE_HEIGHT / 2, maximum_y),
            )
        )
        control["rail"].move(control["button"], 0, handle_y)
        control["handle_y"] = handle_y

    @staticmethod
    def schedule_hide(_window, event, control):
        if event.detail == Gdk.NotifyType.INFERIOR:
            return Gdk.EVENT_PROPAGATE

        if control["reveal_source"] is not None:
            GLib.source_remove(control["reveal_source"])
            control["reveal_source"] = None

        if control["revealed"] and control["hide_source"] is None:
            control["hide_source"] = GLib.timeout_add(
                HIDE_DELAY_MS,
                TapeEdges.hide_control,
                control,
            )
        return Gdk.EVENT_PROPAGATE

    @staticmethod
    def hide_control(control):
        button = control["button"]
        button.set_sensitive(False)
        button.get_style_context().remove_class("revealed")
        button.hide()
        control["rail"].set_size_request(EDGE_SENSOR_WIDTH, -1)
        control["hide_source"] = None
        control["revealed"] = False
        return GLib.SOURCE_REMOVE

    @staticmethod
    def reset_control(control):
        for source_name in ("reveal_source", "hide_source"):
            source = control[source_name]
            if source is not None:
                GLib.source_remove(source)
                control[source_name] = None

        button = control["button"]
        button.set_sensitive(False)
        button.get_style_context().remove_class("revealed")
        button.hide()
        control["rail"].set_size_request(EDGE_SENSOR_WIDTH, -1)
        control["revealed"] = False

    def refresh(self):
        state = desktop_state()
        if not state:
            return

        for monitor_name in state["monitors"]:
            left, right, fullscreen = navigation_targets(state, monitor_name)
            availability = {
                "left": bool(left) and not fullscreen,
                "right": bool(right) and not fullscreen,
            }
            for side in ("left", "right"):
                control = self.controls.get((monitor_name, side))
                if not control:
                    continue
                if availability[side]:
                    control["window"].show_all()
                else:
                    self.reset_control(control)
                    control["window"].hide()

    def schedule_refresh(self):
        if not self.refresh_scheduled:
            self.refresh_scheduled = True
            GLib.timeout_add(REFRESH_DELAY_MS, self.run_scheduled_refresh)

    def run_scheduled_refresh(self):
        self.refresh_scheduled = False
        self.refresh()
        return GLib.SOURCE_REMOVE

    def connect_event_socket(self):
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        runtime_directory = os.environ.get("XDG_RUNTIME_DIR")
        if not signature or not runtime_directory:
            GLib.timeout_add(RECONNECT_DELAY_MS, self.retry_event_socket)
            return

        path = os.path.join(
            runtime_directory,
            "hypr",
            signature,
            ".socket2.sock",
        )
        event_socket = None
        try:
            event_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            event_socket.connect(path)
            event_socket.setblocking(False)
        except OSError:
            if event_socket is not None:
                event_socket.close()
            GLib.timeout_add(RECONNECT_DELAY_MS, self.retry_event_socket)
            return

        self.event_socket = event_socket
        self.event_buffer = ""
        GLib.io_add_watch(
            event_socket,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            self.handle_event_socket,
        )

    def retry_event_socket(self):
        if self.event_socket is None:
            self.connect_event_socket()
        return GLib.SOURCE_REMOVE

    def handle_event_socket(self, event_socket, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.disconnect_event_socket()
            return GLib.SOURCE_REMOVE

        try:
            chunk = event_socket.recv(65536)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self.disconnect_event_socket()
            return GLib.SOURCE_REMOVE

        if not chunk:
            self.disconnect_event_socket()
            return GLib.SOURCE_REMOVE

        self.event_buffer += chunk.decode(errors="replace")
        lines = self.event_buffer.split("\n")
        self.event_buffer = lines.pop()
        if any(line.startswith(REFRESH_EVENTS) for line in lines):
            self.schedule_refresh()

        return GLib.SOURCE_CONTINUE

    def disconnect_event_socket(self):
        if self.event_socket is not None:
            self.event_socket.close()
            self.event_socket = None
        GLib.timeout_add(RECONNECT_DELAY_MS, self.retry_event_socket)


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "--step":
        step(sys.argv[2], sys.argv[3])
        return

    runtime_directory = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    lock = open(os.path.join(runtime_directory, "tape-edges.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    signal.signal(signal.SIGTERM, lambda *_arguments: Gtk.main_quit())
    TapeEdges()
    Gtk.main()


if __name__ == "__main__":
    main()
