#!/bin/bash

set -e

(( EUID != 0 )) || { echo "run as your desktop user, without sudo" >&2; exit 1; }

URL=https://repo.steampowered.com/steam/archive/stable/steam_latest.tar.gz
STEAM_DIR="$HOME/.local/share/Steam"

# Refuse to abandon a different client tree or overwrite real user directories.
for LINK in "$HOME/.steam/root" "$HOME/.steam/steam"; do
	if [ -e "$LINK" ] || [ -L "$LINK" ]; then
		if [ ! -L "$LINK" ] || [ "$(readlink -m "$LINK")" != "$(readlink -m "$STEAM_DIR")" ]; then
			printf 'Migrate the existing Steam location before installing: %s\n' "$LINK" >&2
			exit 1
		fi
	fi
done

sudo apt update
sudo apt install steam-libs steam-libs-i386:i386

# install
mkdir -p "$STEAM_DIR" "$HOME/bin"
cd "$STEAM_DIR"
ARCHIVE="$(mktemp)"
trap 'rm -f "$ARCHIVE"' EXIT
curl -fL "$URL" -o "$ARCHIVE"
tar xf "$ARCHIVE" --strip-components=1 steam-launcher/{bin_steam.sh,bootstraplinux_ubuntu12_32.tar.xz}

# The vendor launcher follows these links when choosing its installation.
mkdir -p "$HOME/.steam"
ln -sfnT "$STEAM_DIR" "$HOME/.steam/root"
ln -sfnT "$STEAM_DIR" "$HOME/.steam/steam"

# launcher
cat > "$HOME/bin/steam" <<'EOF'
#!/bin/bash
set -e
exec "$HOME/.local/share/Steam/bin_steam.sh" "$@"
EOF
chmod +x "$HOME/bin/steam"

# Factorio (prefer native Wayland)
mkdir -p "$HOME/.factorio/config"
crudini --set "$HOME/.factorio/config/config.ini" \
	graphics \
	linux-preferred-video-driver wayland
