{
  // Interface: preserve terminal colors and show only useful signals.
  "colorscheme": "simple",
  "scrollbar": true,
  "diffgutter": true,
  "hlsearch": true,
  "hltrailingws": true,
  "statusformatr": "",

  // Editing: two-column tabs, word wrapping, and clean saves.
  "tabsize": 2,
  "softwrap": true,
  "wordwrap": true,
  "rmtrailingws": true,

  // Files: accept diagnostic paths, follow changes, and preserve working state.
  "parsecursor": true,
  "reload": "auto",
  "mkparents": true,
  "autosu": true,
  "savecursor": true,
  "saveundo": true
}
