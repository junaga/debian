{
  // Add the PC editor conventions missing from Micro's built-in keymap.

  // 1984 Macintosh
  "CtrlN": "AddTab",
  "CtrlW": "ForceQuit",

  // 1987 IBM CUA
  "CtrlInsert": "Copy|CopyLine",
  "ShiftInsert": "Paste",
  "ShiftDelete": "Cut|CutLine",

  // 1990s Windows
  "CtrlH": "DeleteWordLeft", // Ctrl+Backspace in terminals
  "CtrlDelete": "DeleteWordRight",
  "CtrlShiftHome": "SelectToStart",
  "CtrlShiftEnd": "SelectToEnd",
  "F3": "FindNext|Find",

  // 2000s KDE
  "CtrlShiftS": "SaveAs",
  "ShiftF3": "FindPrevious|Find",
  "CtrlG": "command-edit:goto ",
  "CtrlR": "command-edit:replace ",

  // 2011 Sublime Text 2
  "CtrlP": "OpenFile",
  "CtrlL": "SelectLine",
  "CtrlD": "SpawnMultiCursor",

  // 2015 Visual Studio Code
  "CtrlBackslash": "JumpToMatchingBrace", // Ctrl+Shift+\
  "Alt-MouseLeft": "MouseMultiCursor"
}
