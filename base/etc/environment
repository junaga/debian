# PATH="/usr/local/bin:/usr/bin:/bin"
# HOME="/home/$USER"
WORK="/usr/local"
REPO="/usr/local/src"

# Reduce supply-chain risk.
NPM_CONFIG_MIN_RELEASE_AGE="1"
UV_EXCLUDE_NEWER="P1D"

# Keep npm downloads outside the persistent home directory.
NPM_CONFIG_CACHE="/var/cache/npm"

# UV installations
UV_TOOL_DIR="/usr/lib/uv/tools"
UV_TOOL_BIN_DIR="/usr/bin"
UV_CACHE_DIR="/var/cache/uv"
