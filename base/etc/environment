# PATH="/usr/local/bin:/usr/bin:/bin"
# HOME="/home/$USER"
WORK="/usr/local"
REPO="/usr/local/src"

LANG="C.UTF-8"
PAGER="less"
EDITOR="micro"
SHELL="bash"
# EXPLORER=
# BROWSER=
AGENT="codex"

# Reduce supply-chain risk.
NPM_CONFIG_MIN_RELEASE_AGE="1"
UV_EXCLUDE_NEWER="P1D"

# UV installations
UV_TOOL_DIR="/usr/lib/uv/tools"
UV_TOOL_BIN_DIR="/usr/bin"
UV_CACHE_DIR="/var/cache/uv"

# Shared editor configuration.
MICRO_CONFIG_HOME="/etc/micro"
