{
  // Interface
  "colorscheme": "simple",
  "scrollbar": true,
  "diffgutter": true,
  "hlsearch": true,
  "hltrailingws": true,
  "statusformatl": "$(filename):$(line):$(col) $(modified)$(overwrite)$(status.paste)",
  "statusformatr": "$(opt:filetype) | $(status.size) | $(percentage)%",

  // Editing
  "tabsize": 2,
  "softwrap": true,
  "wordwrap": true,
  "rmtrailingws": true,

  // Files
  "parsecursor": true,
  "reload": "auto",
  "mkparents": true,
  "autosu": true,
  "savecursor": true,
  "saveundo": true
}
