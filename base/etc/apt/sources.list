###############################################################################
# REPOS
###############################################################################

# Microsoft
deb [signed-by=/etc/apt/keyrings/microsoft-debian13.gpg] https://packages.microsoft.com/debian/13/prod trixie main

# NVIDIA
deb [signed-by=/etc/apt/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/ /

# Google Cloud
deb [signed-by=/etc/apt/keyrings/google-cloud.gpg] https://packages.cloud.google.com/apt cloud-sdk main

# GitLab
deb [signed-by=/etc/apt/keyrings/gitlab.gpg] https://packages.gitlab.com/gitlab/gitlab-ce/debian trixie main


###############################################################################
# TOOLS
###############################################################################

# `node`, `npm`, `npx`
deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main

# `az` (Azure CLI)
deb [signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ bookworm main

# `mongosh`
deb [signed-by=/etc/apt/keyrings/mongodb.gpg] https://repo.mongodb.org/apt/debian bookworm/mongodb-org/8.0 main

# `gh`
deb [signed-by=/etc/apt/keyrings/github-cli.gpg] https://cli.github.com/packages stable main

# `tailscale`
deb [signed-by=/etc/apt/keyrings/tailscale.gpg] https://pkgs.tailscale.com/stable/debian trixie main

# `protonvpn` and Proton VPN
deb [signed-by=/etc/apt/keyrings/protonvpn.gpg] https://repo.protonvpn.com/debian stable main

# `op` and 1Password
deb [signed-by=/etc/apt/keyrings/1password.gpg] https://downloads.1password.com/linux/debian/amd64 stable main


###############################################################################
# APPS
###############################################################################

# Google Chrome
deb [signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main

# Firefox
deb [signed-by=/etc/apt/keyrings/mozilla.gpg] https://packages.mozilla.org/apt mozilla main

# Brave Browser
deb [signed-by=/etc/apt/keyrings/brave.gpg] https://brave-browser-apt-release.s3.brave.com stable main

# Signal
deb [signed-by=/etc/apt/keyrings/signal.gpg] https://updates.signal.org/desktop/apt xenial main

# Visual Studio Code
deb [signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main
