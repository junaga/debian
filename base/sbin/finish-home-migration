#!/bin/bash
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME_MOUNT=/home
HYPR_HOME=/home/hypr
LEGACY_SNAPSHOTS=/home/.legacy-snapshots
HOME_UUID=47e498ee-c3ec-4708-b732-747c122114c0
ARCHIVE_UUID=44db4ead-1413-4041-b963-33e5c634c381
BACKUP=/mnt/archive/home-restore-backup-20260811
MARKER=/var/lib/home-migration-complete
ROOT_COPY_MARKER=/var/lib/home-migration-root-copy-complete
LOCK=/run/finish-home-migration.lock

exec 9>"$LOCK"
flock -n 9 || exit 0
exec >>/var/log/finish-home-migration.log 2>&1
trap 'status=$?; echo "HOME migration failed at line $LINENO (status $status)"; exit $status' ERR

echo "Starting root/hypr Btrfs HOME migration"

mount_uuid() {
	blkid -s UUID -o value "$(findmnt -n -o SOURCE --mountpoint "$1")"
}

test "$(findmnt -n -o FSTYPE --mountpoint "$HOME_MOUNT")" = btrfs
test "$(mount_uuid "$HOME_MOUNT")" = "$HOME_UUID"
test "$(mount_uuid /mnt/archive)" = "$ARCHIVE_UUID"
test "$(findmnt -n -o FSTYPE --mountpoint /)" = ext4
! mountpoint -q /usr/local
test -d "$BACKUP"
test -x /usr/local/bin/codex
test -d /usr/local/src/.git
/usr/local/bin/codex --version

# Refresh the independent recovery copy before changing a pathname.  Historical
# Btrfs subvolumes are retained separately and are not recursively duplicated.
rsync -aHAX --numeric-ids --one-file-system \
	--exclude=/.snapshots/ --exclude=/.legacy-snapshots/ --exclude=/hypr/ \
	"$HOME_MOUNT/" "$BACKUP/"

cat >"$BACKUP/MIGRATION-MANIFEST.txt" <<'EOF'
The original flat HOME tree was captured here immediately before migration.
The live layout is root terminal state in /root and desktop state in
/home/hypr. Reproducible caches and old rootless container layers remain in
this archive but were intentionally not activated under either account.
The original Btrfs snapshots remain mounted at /home/.legacy-snapshots.
EOF

# A writable Btrfs snapshot performs the cross-subvolume migration by reflink:
# all durable desktop data is present before any obsolete path is removed.
if ! test -e "$HYPR_HOME"; then
	btrfs subvolume snapshot "$HOME_MOUNT" "$HYPR_HOME"
fi
btrfs subvolume show "$HYPR_HOME" >/dev/null

if test -e "$HOME_MOUNT/.snapshots" && ! test -e "$LEGACY_SNAPSHOTS"; then
	mv "$HOME_MOUNT/.snapshots" "$LEGACY_SNAPSHOTS"
fi
test ! -e "$HOME_MOUNT/.snapshots"
test -d "$LEGACY_SNAPSHOTS"
btrfs subvolume show "$LEGACY_SNAPSHOTS" >/dev/null

# Reclaim bounded system-log history before placing irreplaceable terminal
# state on the small ext4 root filesystem.
journalctl --rotate || true
journalctl --vacuum-size=1G || true
install -d -m 0700 -o root -g root /root
# PID 1 always runs as root, so usermod refuses to edit the root account even
# during early boot.  Update only the two intended passwd fields and validate
# the database immediately; password, UID, GID, and GECOS remain unchanged.
sed -i -E \
	's|^(root:[^:]*:0:0:[^:]*:)[^:]*:[^:]*$|\1/root:/bin/bash|' \
	/etc/passwd
test "$(getent passwd root | cut -d: -f6-7)" = /root:/bin/bash

copy_root_item() {
	local relative=$1
	if test -e "$HOME_MOUNT/$relative" || test -L "$HOME_MOUNT/$relative"; then
		install -d -m 0700 "/root/$(dirname "$relative")"
		rsync -aHAX --delete --numeric-ids \
			--exclude='daemon.sock' --exclude='*.pid' \
			"$HOME_MOUNT/$relative" "/root/$(dirname "$relative")/"
	fi
}

# Terminal credentials, configuration, conversations, history, and agent
# profiles are root state.  Large reinstallable package caches are not.
root_items=(
	.bash_history .bashrc .profile .ssh .gitconfig .npmrc .python_history
	.wget-hsts .crates2.json .android .dotnet .terraform.d .luarocks .copilot
	.codex .openclaw-chrome .openclaw-chrome-profile
	.openclaw-dev .openclaw-shared .openclaw-state .openclaw.pre-migration
	.config/gh .config/git .config/micro .config/fish .config/btop
	.config/procps .config/uv .config/screeps-cli .config/systemd
)
if ! test -e "$ROOT_COPY_MARKER"; then
	for item in "${root_items[@]}"; do
		copy_root_item "$item"
	done

# Keep agent state, but do not duplicate program payloads which are installed
# under /usr/local below.
if test -d "$HOME_MOUNT/.grok"; then
	install -d -m 0700 /root/.grok
	rsync -aHAX --delete --numeric-ids --exclude=/downloads/ --exclude=/bin/ \
		"$HOME_MOUNT/.grok/" /root/.grok/
fi
if test -d "$HOME_MOUNT/.dev-browser"; then
	install -d -m 0700 /root/.dev-browser
	rsync -aHAX --delete --numeric-ids --exclude=/node_modules/ \
		--exclude=/daemon.sock --exclude='*.pid' \
		"$HOME_MOUNT/.dev-browser/" /root/.dev-browser/
fi

# Hermes keeps its state in root's HOME, while its program tree is local
# administrator software.  Dependency trees are intentionally rebuilt rather
# than retaining a virtual environment whose entry points embed the old HOME.
if test -d "$HOME_MOUNT/.hermes"; then
	install -d -m 0700 /root/.hermes
	rsync -aHAX --delete --numeric-ids --exclude=/hermes-agent/ \
		"$HOME_MOUNT/.hermes/" /root/.hermes/
	install -d -m 0755 /usr/local/lib/hermes-agent
	rsync -aHAX --delete --numeric-ids \
		--exclude=/.git/ --exclude=/node_modules/ \
		--exclude='__pycache__/' \
		"$HOME_MOUNT/.hermes/hermes-agent/" /usr/local/lib/hermes-agent/
	cat >/usr/local/bin/hermes <<'EOF'
#!/bin/bash
unset PYTHONHOME PYTHONPATH
cd /usr/local/lib/hermes-agent
exec /usr/local/lib/hermes-agent/venv/bin/python -m hermes_cli.main "$@"
EOF
	chmod 0755 /usr/local/bin/hermes
fi

# User-installed executables become root-owned system-local programs.  Known
# HOME-bound launchers are replaced below instead of copied.
if test -d "$HOME_MOUNT/.local/bin"; then
	while IFS= read -r -d '' program; do
		case "${program##*/}" in
			hermes|grok|agent|python3.11|terminaltexteffects|tte) continue ;;
		esac
		install -m 0755 "$program" "/usr/local/bin/${program##*/}"
	done < <(find "$HOME_MOUNT/.local/bin" -maxdepth 1 -type f -perm /111 -print0)
fi
if test -x "$HOME_MOUNT/.grok/downloads/grok-linux-x86_64"; then
	install -d -m 0755 /usr/local/lib/grok
	install -m 0755 "$HOME_MOUNT/.grok/downloads/grok-linux-x86_64" \
		/usr/local/lib/grok/grok
	ln -sfn ../lib/grok/grok /usr/local/bin/grok
	ln -sfn ../lib/grok/grok /usr/local/bin/agent
	install -d -m 0755 /root/.grok/bin
	ln -sfn /usr/local/bin/grok /root/.grok/bin/grok
	ln -sfn /usr/local/bin/agent /root/.grok/bin/agent
fi
if test -d "$HOME_MOUNT/.cargo/bin"; then
	find "$HOME_MOUNT/.cargo/bin" -maxdepth 1 -type f -perm /111 -exec \
		install -m 0755 {} /usr/local/bin/ \;
fi
copy_root_item .cargo/config.toml

# These are reproducible caches inside otherwise durable agent profiles.  The
# independent archive retains the pre-migration copies.
rm -rf --one-file-system -- \
	/root/.codex/cache \
	/root/.openclaw-chrome/Default/Cache \
	/root/.openclaw-chrome/Default/Code\ Cache

# Keep ordinary free space after the copy; do not rely only on ext4's
# root-reserved blocks for the first post-migration boot.
test "$(df --output=avail -B1 / | tail -1)" -ge 536870912
touch "$ROOT_COPY_MARKER"
fi

# Versioned root policy wins over the old account's generic shell template.
install -m 0644 /usr/local/src/base/home/.bashrc /root/.bashrc
install -m 0644 /usr/local/src/base/home/.profile /root/.profile
chown -R root:root /root
chmod 0700 /root /root/.ssh 2>/dev/null || true
find /root/.ssh -type d -exec chmod 0700 {} + 2>/dev/null || true
find /root/.ssh -type f -exec chmod 0600 {} + 2>/dev/null || true

# Codex sessions keep `/usr/local` as their workspace, but live configuration
# must discover its state at root's conventional CODEX_HOME.  Historical JSONL
# and databases are left byte-for-byte intact.
find /root/.codex -maxdepth 1 -type f -print0 | while IFS= read -r -d '' file; do
	if grep -Iq '/usr/local/.codex' "$file"; then
		sed -i 's|/usr/local/\.codex|/root/.codex|g' "$file"
	fi
done
if test -L /root/.codex/plugins/cache/openai-bundled/chrome/latest; then
	target=$(readlink /root/.codex/plugins/cache/openai-bundled/chrome/latest)
	ln -sfn "${target/\/usr\/local\/.codex/\/root\/.codex}" \
		/root/.codex/plugins/cache/openai-bundled/chrome/latest
fi

# Generated user services must follow the new terminal identity.  Do not use a
# compatibility HOME override: the service now runs naturally as root.
if test -f /root/.config/systemd/user/openclaw-gateway.service; then
	sed -i \
		-e 's|Environment="HOME=/usr/local"|Environment="HOME=/root"|' \
		-e 's|/usr/local/\.local/bin:|/root/.local/bin:|' \
		-e 's|/usr/local/\.npm-global/bin:|/root/.npm-global/bin:|' \
		/root/.config/systemd/user/openclaw-gateway.service
fi

# Reuse UID/GID 1000 so the desktop tree retains its established ownership,
# but remove the obsolete human identity everywhere account tools manage it.
loginctl terminate-user junaga 2>/dev/null || true
systemctl stop user@1000.service user-runtime-dir@1000.service 2>/dev/null || true
if getent passwd junaga >/dev/null; then
	usermod --login hypr --home "$HYPR_HOME" --shell /bin/bash junaga
fi
if getent group junaga >/dev/null; then
	groupmod --new-name hypr junaga
fi
usermod --gid hypr --home "$HYPR_HOME" --shell /bin/bash hypr
# The desktop identity keeps hardware groups but not Debian's unrestricted
# administrator group.  Its sole root transition is the audited sudoers rule.
gpasswd --delete hypr sudo 2>/dev/null || true
sed -i 's/^junaga:/hypr:/' /etc/subuid /etc/subgid
sed -i -E 's/(^|,)junaga(,|$)/\1hypr\2/g' /etc/group /etc/gshadow
if test -f /var/spool/cron/crontabs/junaga; then
	mv /var/spool/cron/crontabs/junaga /var/spool/cron/crontabs/root
	chown root:crontab /var/spool/cron/crontabs/root
	chmod 0600 /var/spool/cron/crontabs/root
fi
test "$(id -u hypr)" = 1000
test "$(id -g hypr)" = 1000

if test -e /var/lib/systemd/linger/junaga; then
	mv /var/lib/systemd/linger/junaga /var/lib/systemd/linger/hypr
fi
loginctl disable-linger hypr || true

remove_hypr_item() {
	local target="$HYPR_HOME/$1"
	case "$target" in "$HYPR_HOME"/*) ;; *) return 1 ;; esac
	rm -rf --one-file-system -- "$target"
}

# Remove terminal identity and reproducible tool caches from the desktop
# branch. Their pre-migration forms remain in the archive; durable terminal
# state was copied to /root above.
for item in "${root_items[@]}"; do remove_hypr_item "$item"; done
for item in \
	.cargo .npm .gradle .hermes .grok .dev-browser .openclaw-chrome \
	.openclaw-chrome-profile .openclaw-dev .openclaw-shared .openclaw-state \
	.config/containers .local/share/containers .local/share/pipx \
	.local/share/uv .local/bin; do
	remove_hypr_item "$item"
done

# Steam is desktop application data, not a system-local program tree.
install -d -m 0755 "$HYPR_HOME/.local/share"
if test -d "$HYPR_HOME/lib/steam" && test ! -e "$HYPR_HOME/.local/share/Steam"; then
	mv "$HYPR_HOME/lib/steam" "$HYPR_HOME/.local/share/Steam"
fi
remove_hypr_item lib

# Administrator content already exists and was verified on the ext4 root
# filesystem under /usr/local.  It must not be duplicated in desktop history.
for item in app dev key src var \
	HYPRLAND-DEBIAN-ABI-CRASH.md agentic-engineering.md mental-model.md; do
	remove_hypr_item "$item"
done

# Add missing Debian defaults without replacing migrated desktop state.
for skeleton in /etc/skel/.[!.]*; do
	test -e "$HYPR_HOME/${skeleton##*/}" || cp -a "$skeleton" "$HYPR_HOME/"
done

# The old flat live tree is now independently backed up, represented by the
# writable hypr branch, and retained in legacy read-only snapshots.
while IFS= read -r -d '' obsolete; do
	case "$obsolete" in
		"$HYPR_HOME"|"$LEGACY_SNAPSHOTS") continue ;;
	esac
	# A rescue Codex process may still be appending the conversation which is
	# repairing this migration.  Leave that directory visible until the process
	# exits; the retry then archives the final rollout and removes it normally.
	if test "$obsolete" = "$HOME_MOUNT/.codex" && \
		find /proc/[0-9]*/fd -maxdepth 1 -lname "$obsolete/*" \
			-print -quit 2>/dev/null | grep -q .; then
		continue
	fi
	test "$(dirname "$obsolete")" = "$HOME_MOUNT"
	rm -rf --one-file-system -- "$obsolete"
done < <(find "$HOME_MOUNT" -mindepth 1 -maxdepth 1 -print0)

chown root:root "$HOME_MOUNT"
chmod 0755 "$HOME_MOUNT"
# Never descend into Snapper's control tree: existing snapshots are read-only
# history and retries must neither rewrite nor fail on them.
find "$HYPR_HOME" -path "$HYPR_HOME/.snapshots" -prune -o \
	\( ! -user hypr -o ! -group hypr \) -exec chown hypr:hypr {} +

# Snapper receives a new nested control subvolume.  Only the hypr desktop—not
# /home as a whole, /root, or the legacy history—is in the new policy.
if test -d "$HYPR_HOME/.snapshots" && \
	! btrfs subvolume show "$HYPR_HOME/.snapshots" >/dev/null 2>&1; then
	rmdir "$HYPR_HOME/.snapshots"
fi
if ! btrfs subvolume show "$HYPR_HOME/.snapshots" >/dev/null 2>&1; then
	btrfs subvolume create "$HYPR_HOME/.snapshots"
fi
chown root:root "$HYPR_HOME/.snapshots"
chmod 0750 "$HYPR_HOME/.snapshots"
install -m 0644 /usr/local/src/desktop/etc/snapper/configs/home \
	/etc/snapper/configs/home
if btrfs qgroup show "$HYPR_HOME" 2>/dev/null |
	awk '$1 == "1/0" { found = 1 } END { exit !found }'; then
	snapper --config home set-config QGROUP=1/0
else
	snapper --config home setup-quota
fi
# The former whole-/home Snapper config may have left its newest legacy
# snapshot attached to the reusable 1/0 cleanup qgroup.  Keep legacy history
# mounted, but exclude it from the new hypr policy's accounting.
while read -r legacy_id; do
	btrfs qgroup remove "0/$legacy_id" 1/0 "$HOME_MOUNT" 2>/dev/null || true
done < <(btrfs subvolume list -o "$LEGACY_SNAPSHOTS" | awk '{print $2}')
btrfs qgroup show -pcre "$HOME_MOUNT" | awk \
	'$6 ~ /(^|,)1\/0(,|$)/ && $NF ~ /^\.legacy-snapshots\// { bad = 1 }
	 END { exit bad }'
if ! grep -Fq '<description>root/hypr desktop migration</description>' \
	"$HYPR_HOME"/.snapshots/*/info.xml 2>/dev/null; then
	snapper --config home create --read-only --cleanup-algorithm timeline \
		--description "root/hypr desktop migration"
fi

# Install the authority boundary and boot path from versioned files.
install -m 0755 /usr/local/src/base/bin/desktop /usr/local/bin/desktop
install -d -m 0755 /usr/local/libexec
install -m 0755 /usr/local/src/base/libexec/start-hypr-desktop \
	/usr/local/libexec/start-hypr-desktop
install -m 0755 /usr/local/src/base/sbin/root-shell /usr/local/sbin/root-shell
install -d -m 0750 /etc/sudoers.d
cat >/etc/sudoers.d/020-hypr-root-shell <<'EOF'
hypr ALL=(root) NOPASSWD: /usr/local/sbin/root-shell
EOF
chmod 0440 /etc/sudoers.d/020-hypr-root-shell
rm -f /etc/sudoers.d/010-junaga-nopasswd /etc/sudoers.d/openclaw-nopasswd
if test -e /etc/sudoers.d/010- && test ! -s /etc/sudoers.d/010-; then
	chmod 0440 /etc/sudoers.d/010-
fi
visudo --check --strict

install -d -m 0755 /etc/systemd/system/getty@.service.d
install -m 0644 /usr/local/src/migration/getty-override.conf \
	/etc/systemd/system/getty@.service.d/override.conf

chown -R root:root /usr/local
systemctl daemon-reload
systemctl enable snapper-timeline.timer snapper-cleanup.timer
systemctl set-default multi-user.target

# End-to-end assertions run before login is unblocked and before the marker is
# written.  A failed assertion leaves the service enabled for repair/retry.
test "$(getent passwd root | cut -d: -f6)" = /root
test "$(getent passwd hypr | cut -d: -f6)" = "$HYPR_HOME"
! getent passwd junaga >/dev/null
! getent group junaga >/dev/null
! rg -q '(^|[:,])junaga([,:]|$)' /etc/group /etc/gshadow /etc/subuid /etc/subgid
test -f /root/.codex/auth.json
test -n "$(find /root/.codex/sessions -type f -print -quit)"
test -x /usr/local/bin/codex
/usr/local/bin/codex --version
HOME=/root bash -ic 'cd /usr/local; type codex >/dev/null' </dev/null
# Avoid pam_systemd here: this service intentionally runs before user@1000,
# while a full login session would wait for that unit and deadlock the boot.
test "$(runuser --user hypr -- /bin/sh -c 'printf %s "$HOME"')" = "$HYPR_HOME"
btrfs subvolume show "$HYPR_HOME" >/dev/null
btrfs subvolume show "$HYPR_HOME/.snapshots" >/dev/null
test -z "$(find "$HOME_MOUNT" -mindepth 1 -maxdepth 1 \
	! -name hypr ! -name .legacy-snapshots ! -name .codex -print -quit)"
test -z "$(find /usr/local \( ! -user root -o ! -group root \) -print -quit)"
test -z "$(find "$HYPR_HOME" -path "$HYPR_HOME/.snapshots" -prune -o \
	\( ! -user hypr -o ! -group hypr \) -print -quit)"
test "$(snapper --config home get-config | awk '$1 == "SUBVOLUME" {print $3}')" = "$HYPR_HOME"
snapper --config home list >/dev/null
systemd-analyze verify /etc/systemd/system/finish-home-migration.service
rg -q '^shell /usr/bin/sudo -H -n /usr/local/sbin/root-shell$' \
	"$HYPR_HOME/.config/kitty/kitty.conf"

if test -e "$HOME_MOUNT/.codex"; then
	echo "Migration ready; waiting for the active rescue Codex rollout to close"
	exit 75
fi

touch "$MARKER"
loginctl enable-linger root
echo "root/hypr Btrfs HOME migration complete"
