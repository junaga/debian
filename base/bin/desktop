#!/bin/bash
set -euo pipefail

if (( EUID != 0 )); then
	echo "desktop must be launched from the root VT." >&2
	exit 1
fi

test -d /home/hypr
test "$(getent passwd hypr | cut -d: -f6)" = /home/hypr

# Kernel work is completed before authority is dropped.  A fresh VT login gives
# hypr its own active logind seat, PAM session, and XDG runtime directory; a
# nested runuser under root's tty cannot provide those desktop guarantees.
modprobe -r nvidia_drm 2>/dev/null || true
modprobe nvidia_drm modeset=1
install -d -m 0700 -o hypr -g hypr /home/hypr/.config/hypr/state

original_vt=$(fgconsole)
desktop_vt=2
finish_desktop() {
	systemctl stop hypr-desktop.service 2>/dev/null || true
	chvt "$original_vt" 2>/dev/null || true
}
trap finish_desktop EXIT HUP INT TERM

# systemd owns the desktop tty so login/logind can associate it with seat0.
# openvt alone starts the same process tree, but does not provide systemd with
# TTYPath and pam_systemd consequently rejects the session parameters.
systemctl stop "getty@tty${desktop_vt}.service" 2>/dev/null || true
systemd-run --unit=hypr-desktop --description="Hyprland desktop login" \
	--wait --collect \
	--property=Type=idle \
	--property="TTYPath=/dev/tty${desktop_vt}" \
	--property=StandardInput=tty-force \
	--property=StandardOutput=tty \
	--property=StandardError=tty \
	--property="UtmpIdentifier=tty${desktop_vt}" \
	--property=TTYReset=yes \
	--property=TTYVHangup=yes \
	--property=TTYVTDisallocate=yes \
	/usr/sbin/agetty --autologin hypr \
	--login-options '--shell /usr/local/libexec/start-hypr-desktop -f hypr' \
	--noreset --noclear - linux &
runner=$!

for _ in {1..50}; do
	systemctl is-active --quiet hypr-desktop.service && break
	sleep 0.1
done
systemctl is-active --quiet hypr-desktop.service
chvt "$desktop_vt"
wait "$runner"
