#!/bin/bash
set -Eeuo pipefail

SCRIPT_DIRECTORY=$(cd -- "$(dirname -- "$0")" && pwd)
readonly SCRIPT_DIRECTORY
readonly MIGRATOR=$SCRIPT_DIRECTORY/consolidate-btrfs

(( EUID == 0 )) || {
	printf 'Run this command as root: sudo %s\n' "$0" >&2
	exit 1
}
test -x "$MIGRATOR" || {
	printf 'Migration program is missing: %s\n' "$MIGRATOR" >&2
	exit 1
}

printf 'This will delete the old HOME partition and expand the Btrfs root.\n'
printf 'The verified current HOME archive will be restored as /home.\n\n'
printf 'Type CONSOLIDATE to continue: '
read -r confirmation
[[ $confirmation == CONSOLIDATE ]] || {
	printf 'Cancelled without changing the partition table.\n'
	exit 1
}

exec "$MIGRATOR" --consolidate
