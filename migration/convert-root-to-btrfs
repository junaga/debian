#!/bin/bash
set -Eeuo pipefail

umask 077

readonly ROOT_LINK=/dev/disk/by-id/ata-Samsung_SSD_850_EVO_mSATA_250GB_S33GNX0J713319N-part2
readonly ROOT_UUID=66342810-348d-4508-a1c8-2552b6db1339
readonly ROOT_PARTUUID=5e7dc0f9-ae4e-4a77-a838-a128ed538ec9
readonly ROOT_BYTES=59999518720
readonly ESP_LINK=/dev/disk/by-id/ata-Samsung_SSD_850_EVO_mSATA_250GB_S33GNX0J713319N-part1
readonly ESP_UUID=A31E-0712
readonly HOME_LINK=/dev/disk/by-uuid/47e498ee-c3ec-4708-b732-747c122114c0
readonly ARCHIVE_LINK=/dev/disk/by-uuid/44db4ead-1413-4041-b963-33e5c634c381
readonly TARGET=/mnt/root-btrfs-convert
readonly EFI_CHECK=/mnt/root-btrfs-convert-efi-check
readonly RUNTIME_COPY=/run/convert-root-to-btrfs
readonly LOG_MEDIA_LABEL=BTRFS-CONVERT
readonly LOG_MEDIA_LINK=/dev/disk/by-label/$LOG_MEDIA_LABEL
readonly LOG_MEDIA_MOUNT=/mnt/btrfs-convert-media
readonly MINIMUM_FREE_BYTES=$((8 * 1024 * 1024 * 1024))
readonly PHASE_TOTAL=8

log() {
	printf '\n==> %s\n' "$*"
}

phase() {
	local current=$1 description=$2 width=32 filled empty
	filled=$((current * width / PHASE_TOTAL))
	empty=$((width - filled))
	printf '\n['
	printf '%*s' "$filled" '' | tr ' ' '#'
	printf '%*s' "$empty" '' | tr ' ' '.'
	printf '] %d/%d  %s\n' "$current" "$PHASE_TOTAL" "$description"
}

run_with_heartbeat() {
	local description=$1 pid status elapsed=0
	shift
	"$@" &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		sleep 2
		if kill -0 "$pid" 2>/dev/null; then
			elapsed=$((elapsed + 2))
			printf '\r    %s: %d seconds elapsed; do not interrupt' \
				"$description" "$elapsed"
		fi
	done
	set +e
	wait "$pid"
	status=$?
	set -e
	printf '\r%*s\r' 78 ''
	(( status == 0 )) || die "$description failed with status $status"
	printf '    %s: complete\n' "$description"
}

die() {
	printf 'convert-root-to-btrfs: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat >&2 <<'EOF'
Usage:
  convert-root-to-btrfs --check
  convert-root-to-btrfs --offline-check
  convert-root-to-btrfs --convert --i-accept-no-root-backup [--reboot]

--check is read-only and may run from the installed system.
--offline-check is read-only and must run from independent rescue media.
--convert must run as root from independent Debian live or rescue media.
EOF
	exit 2
}

require_commands() {
	local command
	for command in "$@"; do
		command -v "$command" >/dev/null || die "required command is missing: $command"
	done
}

canonical_device() {
	local link=$1
	test -b "$link" || die "block-device link is absent: $link"
	readlink -f "$link"
}

device_mounts() {
	local device=$1 major_minor
	major_minor=$(lsblk -dnro MAJ:MIN "$device")
	findmnt -rn -o MAJ:MIN,TARGET | awk -v id="$major_minor" '$1 == id { print $2 }'
}

assert_device_identity() {
	local device=$1 expected_uuid=$2 expected_type=$3
	test "$(blkid -p -s UUID -o value "$device")" = "$expected_uuid" ||
		die "unexpected UUID on $device"
	test "$(blkid -p -s TYPE -o value "$device")" = "$expected_type" ||
		die "expected $expected_type on $device"
}

assert_machine_identity() {
	ROOT_DEVICE=$(canonical_device "$ROOT_LINK")
	ESP_DEVICE=$(canonical_device "$ESP_LINK")
	HOME_DEVICE=$(canonical_device "$HOME_LINK")
	ARCHIVE_DEVICE=$(canonical_device "$ARCHIVE_LINK")
	export ROOT_DEVICE ESP_DEVICE HOME_DEVICE ARCHIVE_DEVICE

	test "$(blockdev --getsize64 "$ROOT_DEVICE")" = "$ROOT_BYTES" ||
		die "root partition size does not match the reviewed disk"
	test "$(lsblk -dnro PARTUUID "$ROOT_DEVICE")" = "$ROOT_PARTUUID" ||
		die "root PARTUUID does not match the reviewed disk"
	test "$(blkid -p -s UUID -o value "$ROOT_DEVICE")" = "$ROOT_UUID" ||
		die "root filesystem UUID does not match the reviewed installation"
	assert_device_identity "$ESP_DEVICE" "$ESP_UUID" vfat
	assert_device_identity "$HOME_DEVICE" "${HOME_LINK##*/}" btrfs
	assert_device_identity "$ARCHIVE_DEVICE" "${ARCHIVE_LINK##*/}" ext4
}

check_installed_system() {
	local current_root current_type
	current_root=$(readlink -f "$(findmnt -n -o SOURCE /)")
	test "$current_root" = "$ROOT_DEVICE" ||
		die "the running root is not the reviewed partition"
	current_type=$(blkid -p -s TYPE -o value "$ROOT_DEVICE")
	test "$current_type" = ext4 || die "the reviewed root is already $current_type"

	test -f /root/.codex/auth.json || die "root Codex credentials are absent"
	test -d /usr/local/src/.git || die "the source repository is absent"
	test -f /etc/systemd/system/getty@.service.d/override.conf ||
		die "root VT autologin override is absent"
	grep -q -- '--autologin root' \
		/etc/systemd/system/getty@.service.d/override.conf ||
		die "root VT autologin is not configured"

	log "Read-only preflight passed"
	printf 'root device:       %s\n' "$ROOT_DEVICE"
	printf 'root UUID:         %s\n' "$ROOT_UUID"
	printf 'root size:         %s bytes\n' "$ROOT_BYTES"
	printf 'root free now:     %s\n' "$(df -h --output=avail / | tail -1 | xargs)"
	printf 'disposable swap:   %s\n' "$(du -h /var/swap 2>/dev/null | awk '{print $1}' || printf absent)"
	printf 'HOME device:       %s (not modified)\n' "$HOME_DEVICE"
	printf 'archive device:    %s (not used)\n' "$ARCHIVE_DEVICE"
	printf '\nConversion has not run. Boot independent rescue media first.\n'
}

cleanup_mounts() {
	set +e
	if mountpoint -q "$TARGET"; then
		umount --recursive "$TARGET" 2>/dev/null
	fi
	if mountpoint -q "$EFI_CHECK"; then
		umount "$EFI_CHECK" 2>/dev/null
	fi
}

unmount_conversion_tree() {
	if mountpoint -q "$TARGET"; then
		umount --recursive "$TARGET"
	fi
	if mountpoint -q "$TARGET"; then
		die "conversion tree is still mounted"
	fi
	return 0
}

verify_existing_efi_support() {
	mkdir -p "$EFI_CHECK"
	mount -o ro "$ESP_DEVICE" "$EFI_CHECK"
	strings "$EFI_CHECK/EFI/debian/grubx64.efi" |
		grep btrfs >/dev/null || die "the existing EFI GRUB image lacks Btrfs support"
	umount "$EFI_CHECK"
}

assert_target_boot_readiness() {
	test -f "$TARGET/etc/debian_version" || die "target is not the Debian root"
	test -f "$TARGET/root/.codex/auth.json" || die "target lacks root Codex state"
	for program in usr/sbin/update-initramfs usr/sbin/update-grub \
		usr/sbin/grub-probe usr/bin/lsinitramfs usr/bin/strings; do
		test -x "$TARGET/$program" || die "target boot tool is missing: /$program"
	done
	test -x "$TARGET/usr/share/initramfs-tools/hooks/btrfs" ||
		die "target initramfs lacks the Btrfs hook"
	test -f "$TARGET/boot/grub/grub.cfg" || die "target GRUB config is absent"
	test -n "$(find "$TARGET/boot" -maxdepth 1 -name 'vmlinuz-*' -print -quit)" ||
		die "target kernel image is absent"
	test -n "$(find "$TARGET/boot" -maxdepth 1 -name 'initrd.img-*' -print -quit)" ||
		die "target initramfs image is absent"
	grep -q -- '--autologin root' \
		"$TARGET/etc/systemd/system/getty@.service.d/override.conf" ||
		die "root VT autologin would not return after reboot"
}

require_offline_commands() {
	require_commands awk blkid blockdev btrfs btrfs-convert chmod chown chroot \
		cp date e2fsck find findmnt flock grep head install lsblk mkdir mktemp \
		modprobe mount mountpoint mv readlink reboot rm smartctl strings \
		sleep tee tr tune2fs udevadm umount uname
}

assert_disk_health() {
	local parent_name parent_device health
	parent_name=$(lsblk -dnro PKNAME "$ROOT_DEVICE")
	test -n "$parent_name" || die "cannot identify the root partition's parent disk"
	parent_device=/dev/$parent_name
	health=$(smartctl -H "$parent_device" 2>&1) || {
		printf '%s\n' "$health" >&2
		die "SMART health query failed for $parent_device"
	}
	printf '%s\n' "$health"
	grep -q 'PASSED' <<<"$health" || die "SMART does not report PASSED for $parent_device"
}

assert_live_btrfs_support() {
	modprobe btrfs
	grep -qw btrfs /proc/filesystems || die "the rescue kernel cannot mount Btrfs"
}

start_persistent_log() {
	local log_device log_directory log_file
	if ! test -b "$LOG_MEDIA_LINK"; then
		printf 'WARNING: %s is absent; the transcript will not survive reboot.\n' \
			"$LOG_MEDIA_LINK" >&2
		return
	fi
	log_device=$(readlink -f "$LOG_MEDIA_LINK")
	log_directory=$(findmnt -rn -S "$log_device" -o TARGET |
		awk 'NR == 1 { print; exit }' || true)
	if test -z "$log_directory"; then
		mkdir -p "$LOG_MEDIA_MOUNT"
		mount "$log_device" "$LOG_MEDIA_MOUNT"
		log_directory=$LOG_MEDIA_MOUNT
	fi
	log_file=$log_directory/convert-root-to-btrfs-$(date -u +%Y%m%dT%H%M%SZ).log
	exec > >(tee -a "$log_file") 2>&1
	log "Persistent transcript: $log_file"
}

assert_offline_and_unmounted() {
	assert_machine_identity
	test -z "$(device_mounts "$ROOT_DEVICE")" ||
		die "root partition is mounted; use independent rescue media and unmount it"
	test -z "$(device_mounts "$ESP_DEVICE")" ||
		die "EFI partition is already mounted; unmount it first"
}

check_rescue_environment() {
	local fsck_status
	require_offline_commands
	start_persistent_log
	assert_offline_and_unmounted
	trap cleanup_mounts EXIT
	log "Offline preflight: checking system SSD health"
	assert_disk_health
	assert_live_btrfs_support
	log "Offline preflight: checking EFI boot support"
	verify_existing_efi_support

	log "Offline preflight: checking the installed boot path"
	mkdir -p "$TARGET"
	mount -o ro "$ROOT_DEVICE" "$TARGET"
	assert_target_boot_readiness
	unmount_conversion_tree

	log "Offline preflight: running read-only ext4 check"
	set +e
	e2fsck -C 0 -f -n "$ROOT_DEVICE"
	fsck_status=$?
	set -e
	(( fsck_status == 0 )) || die "read-only e2fsck returned status $fsck_status"

	trap - EXIT
	log "Offline rescue preflight passed without modifying the root"
	printf 'The rescue environment and installed boot path are ready for conversion.\n'
}

patch_fstab() {
	local file=$1 preserve_original=${2:-yes} temporary
	test -f "$file" || die "fstab is absent: $file"
	if [[ $preserve_original == yes ]]; then
		test -e "$file.pre-btrfs-convert" || cp -a "$file" "$file.pre-btrfs-convert"
	fi
	temporary=$(mktemp "$file.tmp.XXXXXX")
	awk '
		BEGIN { roots = 0 }
		/^[[:space:]]*#/ { print; next }
		NF >= 4 && $2 == "/" {
			print $1 "\t/\tbtrfs\tdefaults,noatime,compress=zstd:3\t0\t0"
			roots++
			next
		}
		NF >= 3 && $1 == "/var/swap" && $3 == "swap" {
			print "# Swap is intentionally disabled while ext4 rollback is retained."
			print "# " $0
			next
		}
		{ print }
		END { if (roots != 1) exit 42 }
	' "$file" >"$temporary" || {
		rm -f "$temporary"
		die "could not rewrite the single root entry in $file"
	}
	chmod --reference="$file" "$temporary"
	chown --reference="$file" "$temporary"
	mv "$temporary" "$file"
}

mount_chroot_filesystems() {
	mkdir -p "$TARGET"/{dev,proc,sys,run,boot/efi}
	mount "$ESP_DEVICE" "$TARGET/boot/efi"
	for directory in dev proc sys run; do
		mount --rbind "/$directory" "$TARGET/$directory"
		mount --make-rslave "$TARGET/$directory"
	done
}

verify_boot_artifacts() {
	local image
	test "$(chroot "$TARGET" grub-probe -t fs /)" = btrfs ||
		die "GRUB does not identify the converted root as Btrfs"
	chroot "$TARGET" strings /boot/efi/EFI/debian/grubx64.efi |
		grep btrfs >/dev/null || die "the installed EFI GRUB image lacks Btrfs support"
	grep -q "root=UUID=$ROOT_UUID" "$TARGET/boot/grub/grub.cfg" ||
		die "GRUB does not use the preserved root UUID"
	for image in "$TARGET"/boot/initrd.img-*; do
		test -f "$image" || die "no initramfs image exists"
		chroot "$TARGET" lsinitramfs "/boot/${image##*/}" |
			grep '/btrfs\.ko' >/dev/null || die "Btrfs is absent from ${image##*/}"
	done
}

convert_root() {
	local filesystem_type fsck_status free_blocks block_size free_bytes

	test "${BTRFS_CONVERT_REEXEC:-}" = 1 || {
		install -m 0700 "$0" "$RUNTIME_COPY"
		exec env BTRFS_CONVERT_REEXEC=1 /bin/bash "$RUNTIME_COPY" "$@"
	}

	require_offline_commands
	start_persistent_log
	exec 9>/run/convert-root-to-btrfs.lock
	flock -n 9 || die "another conversion process holds the lock"

	phase 1 "Validate machine, rescue environment, and disk health"
	assert_offline_and_unmounted
	trap cleanup_mounts EXIT
	assert_disk_health
	assert_live_btrfs_support
	printf 'rescue kernel:      %s\n' "$(uname -r)"
	printf 'conversion tool:    %s\n' "$(btrfs-convert --version | head -n 1)"

	phase 2 "Validate EFI and installed boot path"
	verify_existing_efi_support

	filesystem_type=$(blkid -p -s TYPE -o value "$ROOT_DEVICE")
	case "$filesystem_type" in
	ext4)
		log "Preparing ext4 conversion workspace"
		mkdir -p "$TARGET"
		mount "$ROOT_DEVICE" "$TARGET"
		assert_target_boot_readiness
		if test -e "$TARGET/var/swap"; then
			test -f "$TARGET/var/swap" || die "/var/swap is not a regular file"
			printf 'Removing the unused swap file...\n'
			rm -f "$TARGET/var/swap"
			printf 'Swap file removed.\n'
		else
			printf 'Swap file is already absent; resuming safely.\n'
		fi
		run_with_heartbeat "Committing ext4 workspace and unmounting root" \
			unmount_conversion_tree

		phase 3 "Check and safely repair ext4"
		set +e
		e2fsck -C 0 -f -p "$ROOT_DEVICE"
		fsck_status=$?
		set -e
		(( fsck_status <= 1 )) || die "e2fsck returned status $fsck_status"
		free_blocks=$(tune2fs -l "$ROOT_DEVICE" |
			awk -F: '$1 == "Free blocks" { gsub(/ /, "", $2); print $2 }')
		block_size=$(tune2fs -l "$ROOT_DEVICE" |
			awk -F: '$1 == "Block size" { gsub(/ /, "", $2); print $2 }')
		free_bytes=$((free_blocks * block_size))
		(( free_bytes >= MINIMUM_FREE_BYTES )) ||
			die "less than 8 GiB is free after removing swap"

		phase 4 "Convert ext4 metadata to Btrfs"
		btrfs-convert --progress --uuid copy "$ROOT_DEVICE"
		udevadm settle
		;;
	btrfs)
		phase 3 "Skip ext4 check: conversion already completed"
		phase 4 "Resume from the existing Btrfs conversion"
		;;
	*)
		die "unexpected root filesystem type: $filesystem_type"
		;;
	esac

	assert_device_identity "$ROOT_DEVICE" "$ROOT_UUID" btrfs
	phase 5 "Check converted Btrfs without modifying it"
	btrfs check --readonly "$ROOT_DEVICE"

	phase 6 "Configure the converted root"
	mkdir -p "$TARGET"
	mount -o noatime,compress=zstd:3 "$ROOT_DEVICE" "$TARGET"
	btrfs subvolume show "$TARGET/ext2_saved" >/dev/null ||
		die "the ext4 rollback subvolume is absent"
	test -f "$TARGET/ext2_saved/image" || die "the ext4 rollback image is absent"
	patch_fstab "$TARGET/etc/fstab"
	if test -f "$TARGET/usr/local/src/desktop/etc/fstab"; then
		patch_fstab "$TARGET/usr/local/src/desktop/etc/fstab" no
	fi
	grep -Eq '^[^#]+[[:space:]]+/[[:space:]]+btrfs[[:space:]]' \
		"$TARGET/etc/fstab" || die "the live root fstab entry is not Btrfs"
	assert_target_boot_readiness

	phase 7 "Rebuild and verify initramfs and GRUB"
	mount_chroot_filesystems
	chroot "$TARGET" update-initramfs -u -k all
	chroot "$TARGET" update-grub
	verify_boot_artifacts

	phase 8 "Final filesystem and boot verification"
	btrfs filesystem usage "$TARGET"
	printf '\nConversion verified. ext2_saved is intact; do not balance or delete it.\n'
	printf 'Swap is disabled for the first Btrfs boot. HOME and the archive were untouched.\n'
	printf 'The next boot should return to the root VT, where plain codex resumes the session.\n'

	run_with_heartbeat "Committing Btrfs changes and unmounting root" \
		unmount_conversion_tree
	trap - EXIT
	if [[ ${3:-} == --reboot ]]; then
		log "Rebooting into the converted root"
		reboot
	else
		printf '\nRun reboot when ready.\n'
	fi
}

(( EUID == 0 )) || die "must run as root"
case "${1:-}" in
--check)
	require_commands blkid blockdev df du findmnt grep lsblk
	assert_machine_identity
	check_installed_system
	;;
--offline-check)
	check_rescue_environment
	;;
--convert)
	[[ ${2:-} == --i-accept-no-root-backup ]] || usage
	[[ $# -eq 2 || ( $# -eq 3 && $3 == --reboot ) ]] || usage
	convert_root "$@"
	;;
*)
	usage
	;;
esac
